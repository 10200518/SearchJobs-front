---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/pages/login.css';
---

<Layout title="Iniciar Sesión | SearchJobs">
    <Header slot="header" />

    <div class="container">
        <div class="login-container">
            <div class="login-header">
                <h1 class="title">Inicio Sesión</h1>
                <p class="subtitle">Accede a tu cuenta para continuar</p>
            </div>

            <div class="user-type-selector">
                <button
                    type="button"
                    class="user-type-button active"
                    id="candidatoBtn"
                >
                    Candidato
                </button>
                <button
                    type="button"
                    class="user-type-button"
                    id="empresaBtn"
                >
                    Empresa
                </button>
            </div>

            <form class="form" id="loginForm">
                <div class="form-group">
                    <label for="identifier" id="identifierLabel">Correo electrónico</label>
                    <input 
                        type="email"
                        id="identifier"
                        name="identifier"
                        class="form-control"
                        placeholder="ejemplo@correo.com"
                        required
                    />

                    <div class="form-group">
                        <label for="password">Contraseña</label>
                        <div class="password-input">
                            <input type="text"
                                type="password"
                                id="password"
                                name="password"
                                class="form-control"
                                placeholder="Tu contraseña"
                                required
                            />
                            <button
                                type="button"
                                class="password-toggle"
                                id="passwordToggle"
                                aria-label="Mostrar contraseña"
                            >
                            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path>
                                <circle cx="12" cy="12" r="3"></circle>
                            </svg>
                            </button>
                        </div>
                    </div>

                    <div class=""form-options>
                        <label class="remember-label">
                            <input type="checkbox" name="remember" />
                            <span>Recordarme</span>
                        </label>

                        <a href="/recuperar-passaword" class="forgot-password">
                            ¿Olvidaste tu contraseña?
                        </a>
                    </div>

                    <button type="submit" class="btn btn-primary submit-button">
                        Iniciar Sesión
                    </button>

                    <div class="register-container">
                        <p>
                            ¿No tienes una cuenta?{" "}
                            <a href="/registro" class="register-link">
                                Regístrate
                            </a>
                        </p>
                    </div>
                </div>
            </form>
        </div>
    </div>

    <Footer slot="footer" />
</Layout>

<script>
    document.addEventListener('DOMContentLoaded', () => {
      const candidatoBtn = document.getElementById('candidatoBtn');
      const empresaBtn = document.getElementById('empresaBtn');
      const identifierLabel = document.getElementById('identifierLabel');
      const identifier = document.getElementById('identifier');
      const passwordToggle = document.getElementById('passwordToggle');
      const password = document.getElementById('password');
      
      if (candidatoBtn && empresaBtn && identifierLabel && identifier) {
        candidatoBtn.addEventListener('click', () => {
          candidatoBtn.classList.add('active');
          empresaBtn.classList.remove('active');
          identifierLabel.textContent = 'Correo electrónico';
          (identifier as HTMLInputElement).type = 'email';
          (identifier as HTMLInputElement).placeholder = 'ejemplo@correo.com';
        });
        
        empresaBtn.addEventListener('click', () => {
          empresaBtn.classList.add('active');
          candidatoBtn.classList.remove('active');
          identifierLabel.textContent = 'NIT / Identificación fiscal';
          (identifier as HTMLInputElement).type = 'text';
          (identifier as HTMLInputElement).placeholder = 'NIT de tu empresa';
        });
      }
      
      if (passwordToggle && password) {
        passwordToggle.addEventListener('click', () => {
          const type = password.getAttribute('type') === 'password' ? 'text' : 'password';
          password.setAttribute('type', type);
          
          if (type === 'text') {
            passwordToggle.innerHTML = `
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24"></path>
                <line x1="1" y1="1" x2="23" y2="23"></line>
              </svg>
            `;
            passwordToggle.setAttribute('aria-label', 'Ocultar contraseña');
          } else {
            passwordToggle.innerHTML = `
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path>
                <circle cx="12" cy="12" r="3"></circle>
              </svg>
            `;
            passwordToggle.setAttribute('aria-label', 'Mostrar contraseña');
          }
        });
      }
    });
  </script>