<html lang="es">
<head>
  <meta charset="UTF-8" />
  <title>Chat Privado</title>
</head>
<body>
  <h1>Chat Privado</h1>

  <div id="chat-messages" style="border: 1px solid #ccc; height: 300px; overflow-y: scroll; padding: 10px;"></div>

  <input id="message-input" type="text" placeholder="Escribe un mensaje..." style="width: 100%; padding: 10px;" />
  <button id="send-message" style="padding: 10px 20px; background-color: #007BFF; color: white; border: none;">Enviar</button>
    <!-- Cargar bibliotecas al final del cuerpo -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/sockjs-client/1.6.1/sockjs.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/stomp.js/2.3.3/stomp.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/luxon@2.0.2/build/global/luxon.min.js"></script>

  <script type="module">
    const userId = '3'; // Tu ID único de usuario
    let stompClient = null;
    let chatId = null;

    // Conectar al WebSocket
    function connectWebSocket() {
        const socket = new SockJS("wss://localhost:8080/chats");
        stompClient = Stomp.over(socket);

        stompClient.connect({}, function(frame) {
            console.log("Conectado: " + frame);

            // Crear chat privado si no existe
            if (!chatId) {
            createPrivateChat();
            }
        }, function(error) { // Callback de error
            console.error("Error al conectar al WebSocket:", error);
        });
    }


    // Crear un chat privado entre los usuarios
    function createPrivateChat() {
      fetch('http://localhost:8080/api/chats/crear', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ empresaId: userId, candidatoId: '1' }) // Aquí deberías poner el ID del otro usuario
      })
      .then(response => response.json())
      .then(data => {
        chatId = data.id;
        subscribeToMessages(chatId); // Suscribir a este chat privado
      })
      .catch(error => console.error('Error al crear el chat privado:', error));
    }

    // Suscribir al canal de mensajes del chat privado
    function subscribeToMessages(chatId) {
      stompClient.subscribe(`/user/chat/${chatId}`, function(messageOutput) {
        const message = JSON.parse(messageOutput.body);
        displayMessage(message);
      });
    }

    // Mostrar el mensaje en el chat
    function displayMessage(message) {
      const messageContainer = document.getElementById("chat-messages");
      const messageElement = document.createElement("div");
      messageElement.textContent = `${message.senderid}: ${message.content}`;
      messageContainer.appendChild(messageElement);
      messageContainer.scrollTop = messageContainer.scrollHeight; // Desplazar hacia abajo
    }

    // Enviar un mensaje al servidor
    function sendMessage() {
      const messageInput = document.getElementById("message-input");
      const messageContent = messageInput.value.trim();
      const DateTime = luxon.DateTime;

      if (messageContent) {
        const message = {
          content: messageContent,
          senderId: userId,
          receiverId: null,
          chatId: chatId,
          senderRole: null,
          receiverRole: null,
          time: DateTime.now().toFormat("yyyy-MM-dd'T'HH:mm:ss") ,
          state:"enviado"
        };
        stompClient.send("/app/chat.sendMessage", {}, JSON.stringify(message)); // Enviar el mensaje
        displayMessage({ content: messageContent, senderId: 'Tú' });
        messageInput.value = ''; 
      }
    }

    // Configurar eventos
    document.getElementById("send-message").addEventListener("click", sendMessage);

    // Conectar al WebSocket cuando se cargue la página
    window.onload = function() {
      connectWebSocket();
    };
  </script>
</body>
</html>
