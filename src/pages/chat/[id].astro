---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.jsx';
import Footer from '../../components/Footer.astro';
import ChatBox from '../../components/ChatBox';

const { params } = Astro;
const chatId = params.id;
---

<Layout title="Chat | SearchJobs">
<Header client:load />

<div class="container">
  <div class="chat-container">
    <div class="sidebar">
      <div class="sidebar-header">
        <h2 class="sidebar-title">Mensajes</h2>
        <div class="sidebar-actions">
          <button class="sidebar-action-button" aria-label="Nuevo mensaje">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <line x1="12" y1="5" x2="12" y2="19"></line>
              <line x1="5" y1="12" x2="19" y2="12"></line>
            </svg>
          </button>
          <button class="sidebar-action-button" aria-label="Filtrar mensajes">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <polygon points="22 3 2 3 10 12.46 10 19 14 21 14 12.46 22 3"></polygon>
            </svg>
          </button>
        </div>
      </div>

      <div class="search-container">
        <div class="search-input-wrapper">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="search-icon">
            <circle cx="11" cy="11" r="8"></circle>
            <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
          </svg>
          <input type="text" class="search-input" placeholder="Buscar conversaciones..." />
        </div>
      </div>

      <div class="contacts-tabs">
        <button class="contacts-tab active" data-tab="all">Todos</button>
        <button class="contacts-tab" data-tab="unread">No leídos</button>
        <button class="contacts-tab" data-tab="archived">Archivados</button>
      </div>

      <div class="contacts-list" id="contactsList">
        <!-- La lista de contactos se cargará dinámicamente -->
      </div>
    </div>

    <ChatBox client:only="react" chatId={chatId} />


    <!-- <div class="chat-main">
      <div id="emptyChatState" class="empty-chat-state">
        <div class="empty-chat-content">
          <div class="empty-chat-icon">
            <svg xmlns="http://www.w3.org/2000/svg" width="64" height="64" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path>
            </svg>
          </div>
          <h3>Tus mensajes</h3>
          <p>Selecciona una conversación para ver tus mensajes o inicia una nueva</p>
          
        </div>
      </div>

      <div id="chatInterface" class="hidden chat-interface">
        <div class="chat-header" id="chatHeader">
          El encabezado del chat se cargará dinámicamente
        </div>

        <div class="messages-container" id="messagesContainer">
        </div>

        <div class="message-input-container">
          <button class="message-action-button" aria-label="Adjuntar archivo">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M21.44 11.05l-9.19 9.19a6 6 0 0 1-8.49-8.49l9.19-9.19a4 4 0 0 1 5.66 5.66l-9.2 9.19a2 2 0 0 1-2.83-2.83l8.49-8.48"></path>
            </svg>
          </button>
          
          <button class="message-action-button" aria-label="Insertar emoji">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="12" cy="12" r="10"></circle>
              <path d="M8 14s1.5 2 4 2 4-2 4-2"></path>
              <line x1="9" y1="9" x2="9.01" y2="9"></line>
              <line x1="15" y1="9" x2="15.01" y2="9"></line>
            </svg>
          </button>

          <div class="message-input-wrapper">
            <textarea
              id="messageInput"
              class="message-input"
              placeholder="Escribe un mensaje..."
              rows="1"
            ></textarea>
          </div>

          <button id="sendButton" class="send-button" disabled>
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <line x1="22" y1="2" x2="11" y2="13"></line>
              <polygon points="22 2 15 22 11 13 2 9 22 2"></polygon> 
            </svg>
          </button>
        </div>
      </div>
    </div>-->
  </div>
</div>

<Footer slot="footer" />
</Layout>

<script type="js">
  
// Función para formatear la fecha
function formatMessageDate(dateString) {
  const date = new Date(dateString);
  const now = new Date();
  const diffDays = Math.floor((now - date) / (1000 * 60 * 60 * 24));
  
  if (diffDays === 0) {
    return 'Hoy';
  } else if (diffDays === 1) {
    return 'Ayer';
  } else if (diffDays < 7) {
    const days = ['Domingo', 'Lunes', 'Martes', 'Miércoles', 'Jueves', 'Viernes', 'Sábado'];
    return days[date.getDay()];
  } else {
    return date.toLocaleDateString();
  }
}

// Función para formatear la hora
function formatMessageTime(dateString) {
  const date = new Date(dateString);
  return date.toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });
}

document.addEventListener('DOMContentLoaded', () => {
  const contactsList = document.getElementById('contactsList');
  const emptyChatState = document.getElementById('emptyChatState');
  const chatInterface = document.getElementById('chatInterface');
  const chatHeader = document.getElementById('chatHeader');
  const messagesContainer = document.getElementById('messagesContainer');
  const messageInput = document.getElementById('messageInput');
  const sendButton = document.getElementById('sendButton');
  const contactsTabs = document.querySelectorAll('.contacts-tab');
  const searchInput = document.querySelector('.search-input');
  const newChatButton = document.querySelector('.new-chat-button');
  
  let currentFilter = 'all';
  let activeContactId = null;

  // Función para cargar la lista de contactos
  function loadContacts(filter = 'all', searchTerm = '') {
    contactsList.innerHTML = '';
    
    const filteredContacts = contacts.filter(contact => {
      // Filtrar por pestaña
      if (filter === 'unread' && contact.unread === 0) return false;
      if (filter === 'archived' && contact.status !== 'archived') return false;
      if (filter === 'all' && contact.status === 'archived') return false;
      
      // Filtrar por término de búsqueda
      if (searchTerm) {
        const searchLower = searchTerm.toLowerCase();
        return (
          contact.name.toLowerCase().includes(searchLower) ||
          (contact.company && contact.company.toLowerCase().includes(searchLower)) ||
          (contact.position && contact.position.toLowerCase().includes(searchLower))
        );
      }
      
      return true;
    });
    
    if (filteredContacts.length === 0) {
      const emptyState = document.createElement('div');
      emptyState.className = 'empty-contacts-state';
      emptyState.innerHTML = `
        <p>No se encontraron conversaciones${searchTerm ? ' para "' + searchTerm + '"' : ''}.</p>
      `;
      contactsList.appendChild(emptyState);
      return;
    }
    
    filteredContacts.forEach(contact => {
      const contactElement = document.createElement('div');
      contactElement.className = `contact-item ${activeContactId === contact.id ? 'active' : ''}`;
      contactElement.dataset.id = contact.id;
      
      contactElement.innerHTML = `
        <div class="contact-avatar">
          <img src="${contact.avatar}" alt="${contact.name}" width="50" height="50" />
          ${contact.online ? '<span class="online-indicator"></span>' : ''}
        </div>
        <div class="contact-info">
          <div class="contact-header">
            <h3 class="contact-name">${contact.name}</h3>
            <span class="contact-time">${contact.lastMessageTime}</span>
          </div>
          <p class="contact-role">${contact.isRecruiter ? `${contact.role} en ${contact.company}` : `${contact.role} - ${contact.position}`}</p>
          ${contact.isTyping ? 
            `<p class="contact-typing">
              <span class="typing-indicator">
                <span class="typing-dot"></span>
                <span class="typing-dot"></span>
                <span class="typing-dot"></span>
              </span>
              Escribiendo...
            </p>` : 
            `<p class="contact-last-message">${contact.lastMessage}</p>`
          }
        </div>
        ${contact.unread > 0 ? `<div class="unread-badge">${contact.unread}</div>` : ''}
        <div class="contact-actions">
          <button class="contact-action-button" data-action="archive" aria-label="${contact.status === 'archived' ? 'Desarchivar' : 'Archivar'}">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              ${contact.status === 'archived' ? 
                '<polyline points="9 14 4 9 9 4"></polyline><path d="M20 20v-7a4 4 0 0 0-4-4H4"></path>' : 
                '<polyline points="3 6 5 6 21 6"></polyline><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path>'
              }
            </svg>
          </button>
        </div>
      `;
      
      contactsList.appendChild(contactElement);
      
      // Agregar evento de clic para mostrar la conversación
      contactElement.addEventListener('click', (e) => {
        // Si se hizo clic en un botón de acción, no mostrar la conversación
        if (e.target.closest('.contact-action-button')) {
          return;
        }
        
        // Remover clase activa de todos los contactos
        document.querySelectorAll('.contact-item').forEach(item => {
          item.classList.remove('active');
        });
        
        // Agregar clase activa al contacto seleccionado
        contactElement.classList.add('active');
        activeContactId = contact.id;
        
        // Ocultar el estado vacío y mostrar la interfaz de chat
        emptyChatState.classList.add('hidden');
        chatInterface.classList.remove('hidden');
        
        // Actualizar el encabezado del chat
        updateChatHeader(contact);
        
        // Cargar los mensajes de la conversación
        loadMessages(contact.id);
        
        // Si hay mensajes no leídos, marcarlos como leídos
        if (contact.unread > 0) {
          const unreadBadge = contactElement.querySelector('.unread-badge');
          if (unreadBadge) {
            unreadBadge.remove();
          }
          contact.unread = 0;
          
          // Marcar mensajes como leídos
          if (conversationMessages[contact.id]) {
            conversationMessages[contact.id].forEach(msg => {
              if (msg.status === 'unread' && msg.sender === 'recruiter') {
                msg.status = 'read';
              }
            });
          }
        }
      });
      
      // Agregar eventos a los botones de acción
      const archiveButton = contactElement.querySelector('[data-action="archive"]');
      if (archiveButton) {
        archiveButton.addEventListener('click', () => {
          contact.status = contact.status === 'archived' ? 'active' : 'archived';
          loadContacts(currentFilter, searchInput.value);
          
          // Si el contacto archivado es el activo, mostrar el estado vacío
          if (activeContactId === contact.id && contact.status === 'archived' && currentFilter !== 'archived') {
            chatInterface.classList.add('hidden');
            emptyChatState.classList.remove('hidden');
            activeContactId = null;
          }
        });
      }
    });
  }
  
  // Función para actualizar el encabezado del chat
  function updateChatHeader(contact) {
    chatHeader.innerHTML = `
      <div class="chat-header-left">
        <button class="back-button" id="backButton">
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="15 18 9 12 15 6"></polyline>
          </svg>
        </button>
        <div class="chat-header-avatar">
          <img src="${contact.avatar}" alt="${contact.name}" width="40" height="40" />
          ${contact.online ? '<span class="header-online-indicator"></span>' : ''}
        </div>
        <div class="chat-header-info">
          <h3 class="chat-header-name">${contact.name}</h3>
          <p class="chat-header-role">${contact.isRecruiter ? `${contact.role} en ${contact.company}` : `${contact.role} - ${contact.position}`}</p>
        </div>
      </div>
      <div class="chat-header-actions">
        <button class="header-action-button" aria-label="Ver perfil">
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
            <circle cx="12" cy="7" r="4"></circle>
          </svg>
        </button>
        <button class="header-action-button" aria-label="Llamada">
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path>
          </svg>
        </button>
        <button class="header-action-button" aria-label="Videollamada">
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <polygon points="23 7 16 12 23 17 23 7"></polygon>
            <rect x="1" y="5" width="15" height="14" rx="2" ry="2"></rect>
          </svg>
        </button>
        <button class="header-action-button" aria-label="Más opciones">
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="12" r="1"></circle>
            <circle cx="12" cy="5" r="1"></circle>
            <circle cx="12" cy="19" r="1"></circle>
          </svg>
        </button>
      </div>
    `;
    
    // Agregar evento al botón de retroceso
    document.getElementById('backButton').addEventListener('click', () => {
      chatInterface.classList.add('hidden');
      emptyChatState.classList.remove('hidden');
      document.querySelectorAll('.contact-item').forEach(item => {
        item.classList.remove('active');
      });
      activeContactId = null;
    });
  }
  
  // Función para cargar los mensajes de una conversación
  function loadMessages(contactId) {
    messagesContainer.innerHTML = '';
    
    const messages = conversationMessages[contactId] || [];
    if (messages.length === 0) {
      messagesContainer.innerHTML = `
        <div class="no-messages">
          <p>No hay mensajes aún. ¡Comienza la conversación!</p>
        </div>
      `;
      return;
    }
    
    let currentDate = '';
    
    messages.forEach(message => {
      const messageDate = formatMessageDate(message.timestamp);
      
      // Agregar separador de fecha si cambia
      if (messageDate !== currentDate) {
        currentDate = messageDate;
        const dateElement = document.createElement('div');
        dateElement.className = 'message-date';
        dateElement.innerHTML = `<span>${messageDate}</span>`;
        messagesContainer.appendChild(dateElement);
      }
      
      const messageElement = document.createElement('div');
      messageElement.className = `message ${message.sender === 'user' ? 'outgoing' : 'incoming'}`;
      
      let messageContent = `
        <div class="message-content">
          <p>${message.text}</p>
      `;
      
      // Si hay un archivo adjunto
      if (message.attachment) {
        messageContent += `
          <div class="message-attachment">
            <div class="attachment-icon">
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                <polyline points="14 2 14 8 20 8"></polyline>
                <line x1="16" y1="13" x2="8" y2="13"></line>
                <line x1="16" y1="17" x2="8" y2="17"></line>
                <polyline points="10 9 9 9 8 9"></polyline>
              </svg>
            </div>
            <div class="attachment-info">
              <span class="attachment-name">${message.attachment.name}</span>
              <span class="attachment-size">${message.attachment.size}</span>
            </div>
            <button class="attachment-download">
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                <polyline points="7 10 12 15 17 10"></polyline>
                <line x1="12" y1="15" x2="12" y2="3"></line>
              </svg>
            </button>
          </div>
        `;
      }
      
      messageContent += `
          <span class="message-time">${formatMessageTime(message.timestamp)}</span>
          ${message.sender === 'user' ? `
            <span class="message-status">
              ${message.status === 'read' ? 
                '<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 6L9.1 15 6 12"></path><path d="M18 14L9.1 23 6 20"></path></svg>' : 
                '<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6L9 17l-5-5"></path></svg>'}
            </span>
          ` : ''}
        </div>
      `;
      
      messageElement.innerHTML = messageContent;
      messagesContainer.appendChild(messageElement);
    });
    
    // Scroll al final de los mensajes
    messagesContainer.scrollTop = messagesContainer.scrollHeight;
  }
  
  // Función para ajustar la altura del textarea
  function adjustTextareaHeight() {
    messageInput.style.height = 'auto';
    messageInput.style.height = (messageInput.scrollHeight) + 'px';
  }
  
  // Manejar el envío de mensajes
  messageInput.addEventListener('input', () => {
    sendButton.disabled = messageInput.value.trim() === '';
    adjustTextareaHeight();
  });
  
  messageInput.addEventListener('keydown', (e) => {
    if (e.key === 'Enter' && !e.shiftKey && messageInput.value.trim() !== '') {
      e.preventDefault();
      sendMessage();
    }
  });
  
  sendButton.addEventListener('click', () => {
    if (messageInput.value.trim() !== '') {
      sendMessage();
    }
  });
  
  function sendMessage() {
    if (!activeContactId) return;
    
    const messageText = messageInput.value.trim();
    
    // Crear nuevo mensaje
    const newMessage = {
      id: Date.now(),
      sender: 'user',
      text: messageText,
      timestamp: new Date().toISOString(),
      status: 'sent'
    };
    
    // Agregar mensaje a la conversación
    if (!conversationMessages[activeContactId]) {
      conversationMessages[activeContactId] = [];
    }
    conversationMessages[activeContactId].push(newMessage);
    
    // Actualizar la interfaz
    loadMessages(activeContactId);
    
    // Actualizar el último mensaje en la lista de contactos
    const contact = contacts.find(c => c.id === activeContactId);
    if (contact) {
      contact.lastMessage = messageText;
      contact.lastMessageTime = 'Ahora';
      
      // Actualizar la lista de contactos
      loadContacts(currentFilter, searchInput.value);
    }
    
    // Limpiar el input y resetear su altura
    messageInput.value = '';
    messageInput.style.height = 'auto';
    sendButton.disabled = true;
    
    // Cambiar el estado del mensaje a "entregado" después de un momento
    setTimeout(() => {
      newMessage.status = 'delivered';
      loadMessages(activeContactId);
    }, 1000);
    
    // Cambiar el estado del mensaje a "leído" después de otro momento
    setTimeout(() => {
      newMessage.status = 'read';
      loadMessages(activeContactId);
    }, 2000);
    
    // Simular respuesta después de un tiempo aleatorio
    const contactIndex = contacts.findIndex(c => c.id === activeContactId);
    if (contactIndex !== -1) {
      // Primero mostrar "escribiendo..."
      setTimeout(() => {
        contacts[contactIndex].isTyping = true;
        loadContacts(currentFilter, searchInput.value);
      }, 1500);
      
      // Luego enviar la respuesta
      setTimeout(() => {
        contacts[contactIndex].isTyping = false;
        
        const responses = [
          "Gracias por tu mensaje. Lo revisaré y te responderé pronto.",
          "Perfecto, lo tendré en cuenta.",
          "Entendido. ¿Hay algo más que necesites?",
          "Excelente, seguiremos en contacto.",
          "Gracias por la información. Te contactaré pronto con más detalles."
        ];
        
        const responseMessage = {
          id: Date.now(),
          sender: 'recruiter',
          text: responses[Math.floor(Math.random() * responses.length)],
          timestamp: new Date().toISOString(),
          status: 'read'
        };
        
        conversationMessages[activeContactId].push(responseMessage);
        
        // Actualizar el último mensaje en la lista de contactos
        contacts[contactIndex].lastMessage = responseMessage.text;
        contacts[contactIndex].lastMessageTime = 'Ahora';
        
        loadMessages(activeContactId);
        loadContacts(currentFilter, searchInput.value);
      }, 3000 + Math.random() * 2000);
    }
  }
  
  // Manejar las pestañas de contactos
  contactsTabs.forEach(tab => {
    tab.addEventListener('click', () => {
      contactsTabs.forEach(t => t.classList.remove('active'));
      tab.classList.add('active');
      currentFilter = tab.dataset.tab;
      loadContacts(currentFilter, searchInput.value);
    });
  });
  
  // Manejar la búsqueda
  searchInput.addEventListener('input', () => {
    loadContacts(currentFilter, searchInput.value);
  });
  
  // Manejar el botón de nuevo mensaje
  newChatButton.addEventListener('click', () => {
    // Aquí se podría implementar la funcionalidad para iniciar una nueva conversación
    alert('Funcionalidad para iniciar una nueva conversación');
  });
  
  // Cargar contactos iniciales
  loadContacts();
});
</script>

<style>
.chat-container {
  display: grid;
  grid-template-columns: 320px 1fr;
  height: 80vh;
  margin: 40px 0;
  background-color: rgba(255, 255, 255, 0.8);
  backdrop-filter: blur(10px);
  -webkit-backdrop-filter: blur(10px);
  border-radius: var(--radius);
  box-shadow: var(--shadow);
  overflow: hidden;
  border: 1px solid rgba(255, 255, 255, 0.2);
  position: relative;
}

.sidebar {
  border-right: 1px solid rgba(0, 0, 0, 0.05);
  overflow: hidden;
  display: flex;
  flex-direction: column;
}

.sidebar-header {
  padding: 16px 20px;
  border-bottom: 1px solid rgba(0, 0, 0, 0.05);
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.sidebar-title {
