---
import Header from '../../components/Header.astro'
import Layout from '../../layouts/Layout.astro';
import Footer from '../../components/Footer.astro';
import '../../styles/pages/PerfilUsuario.css';
---

<Layout title="Perfil de Usuario | SearchJobs">
  <Header slot="header" />

  <div class="profile-container">
    <header class="profile-header">
      <div class="profile-image">
        <img src="https://via.placeholder.com/150" alt="Foto de perfil">
      </div>
      <h1>María González</h1>
      <p class="title">Desarrolladora Web Frontend</p>
    </header>
    
    <section class="profile-info">
      <div class="info-section">
        <h2><i class="fas fa-user"></i> Sobre mí</h2>
        <p>Soy una desarrolladora web apasionada por crear interfaces de usuario atractivas y funcionales.</p>
      </div>
      
      <div class="info-section">
        <h2><i class="fas fa-briefcase"></i> Experiencia</h2>
        <ul>
          <li>Desarrolladora Frontend en TechSolutions (2020-actualidad)</li>
          <li>Diseñadora UI/UX en Creative Agency (2018-2020)</li>
        </ul>
      </div>
      
      <div class="info-section">
        <h2><i class="fas fa-graduation-cap"></i> Educación</h2>
        <ul>
          <li>Licenciatura en Informática - Universidad Nacional (2014-2018)</li>
          <li>Curso de Diseño UX/UI - Platzi (2019)</li>
        </ul>
      </div>
      
      <div class="info-section">
        <h2><i class="fas fa-code"></i> Habilidades</h2>
        <div class="skills">
          <span>HTML5</span>
          <span>CSS3</span>
          <span>JavaScript</span>
          <span>React</span>
          <span>Figma</span>
        </div>
      </div>
    </section>
    
    <footer class="profile-footer">
      <h2><i class="fas fa-share-alt"></i> Contacto</h2>
      <div class="social-links">
        <a href="#"><i class="fab fa-linkedin"></i></a>
        <a href="#"><i class="fab fa-github"></i></a>
        <a href="#"><i class="fab fa-twitter"></i></a>
        <a href="#"><i class="fas fa-envelope"></i></a>
      </div>
    </footer>
  </div>

  <Footer slot="footer" />
</Layout>