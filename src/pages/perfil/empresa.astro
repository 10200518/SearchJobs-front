---
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Header.jsx";
import Footer from "../../components/Footer.astro";
import JobCard from "../../components/JobCard.astro";

const empresa = {
  nombre: "TechCorp",
  eslogan: "Innovación tecnológica para un futuro mejor",
  ubicacion: "Bogotá, Colombia",
  industria: "Tecnología",
  tamaño: "50-200 empleados",
  fundacion: "2015",
  sitioWeb: "techcorp.com",
  logo: "/placeholder.svg?height=150&width=150&text=TC",
  portada: "/placeholder.svg?height=400&width=1200&text=TechCorp+Banner",
  descripcion:
    "TechCorp es una empresa líder en desarrollo de software y soluciones tecnológicas innovadoras. Nos especializamos en crear productos que transforman la manera en que las empresas operan y se conectan con sus clientes. Nuestro enfoque se centra en la calidad, la innovación y la satisfacción del cliente.",
  mision:
    "Transformar el mundo a través de soluciones tecnológicas innovadoras que mejoren la vida de las personas y el rendimiento de las empresas.",
  vision:
    "Ser reconocidos globalmente como líderes en innovación tecnológica, creando productos que definan el futuro de la industria.",
  valores: [
    "Innovación constante",
    "Excelencia en cada detalle",
    "Trabajo en equipo colaborativo",
    "Integridad y transparencia",
    "Enfoque en el cliente",
  ],
  beneficios: [
    "Horario flexible",
    "Trabajo remoto parcial",
    "Seguro médico complementario",
    "Bonificaciones por desempeño",
    "Capacitación continua",
    "Ambiente de trabajo colaborativo",
    "Eventos de integración",
  ],
  vacantes: [
    {
      id: 1,
      title: "Desarrollador Frontend",
      company: "TechCorp",
      location: "Bogotá, Colombia",
      type: "Tiempo completo",
      experience: "2-3 años",
      logo: "/placeholder.svg?height=80&width=80",
    },
    {
      id: 2,
      title: "Diseñador UX/UI",
      company: "TechCorp",
      location: "Remoto",
      type: "Tiempo completo",
      experience: "3-5 años",
      logo: "/placeholder.svg?height=80&width=80",
    },
    {
      id: 3,
      title: "Desarrollador Backend",
      company: "TechCorp",
      location: "Bogotá, Colombia",
      type: "Tiempo completo",
      experience: "4-6 años",
      logo: "/placeholder.svg?height=80&width=80",
    },
  ],
  redesSociales: {
    linkedin: "linkedin.com/company/techcorp",
    twitter: "twitter.com/techcorp",
    facebook: "facebook.com/techcorp",
    instagram: "instagram.com/techcorp",
  },
  contacto: {
    email: "info@techcorp.com",
    telefono: "+57 601 123 4567",
    direccion: "Calle 100 #15-20, Bogotá, Colombia",
  },
}
---

<Layout title={`${empresa.nombre} | SearchJobs`}>
  <Header slot="header" />
  
  <div class="container px-5 py-10 mx-auto">
    <div class="relative mb-8">
      <div class="h-64 overflow-hidden rounded-lg">
        <img 
          src={empresa.portada || "/placeholder.svg"} 
          alt={`${empresa.nombre} portada`} 
          class="object-cover w-full h-full"
        />
      </div>
      
      <div class="absolute bottom-0 flex items-end transform translate-y-1/2 left-8">
        <div class="w-32 h-32 overflow-hidden border-4 border-white rounded-lg shadow-lg">
          <img 
            src={empresa.logo || "/placeholder.svg"} 
            alt={empresa.nombre} 
            class="object-cover w-full h-full"
          />
        </div>
        
        <div class="mb-4 ml-4">
          <div class="px-4 py-2 rounded-lg shadow-md bg-white/80 backdrop-blur-xl">
            <h1 class="text-2xl font-bold">{empresa.nombre}</h1>
            <p class="text-primary">{empresa.eslogan}</p>
          </div>
        </div>
      </div>
      
      <div class="absolute bottom-0 transform translate-y-1/2 right-8">
        <div class="flex gap-3">
          <a href={`https://${empresa.sitioWeb}`} target="_blank" rel="noopener noreferrer" class="p-3 transition-colors bg-white rounded-full shadow-md hover:bg-primary hover:text-white">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="12" cy="12" r="10"></circle>
              <line x1="2" y1="12" x2="22" y2="12"></line>
              <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"></path>
            </svg>
          </a>
          <a href={`https://${empresa.redesSociales.linkedin}`} target="_blank" rel="noopener noreferrer" class="p-3 transition-colors bg-white rounded-full shadow-md hover:bg-primary hover:text-white">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"></path>
              <rect x="2" y="9" width="4" height="12"></rect>
              <circle cx="4" cy="4" r="2"></circle>
            </svg>
          </a>
          <a href={`https://${empresa.redesSociales.twitter}`} target="_blank" rel="noopener noreferrer" class="p-3 transition-colors bg-white rounded-full shadow-md hover:bg-primary hover:text-white">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M23 3a10.9 10.9 0 0 1-3.14 1.53 4.48 4.48 0 0 0-7.86 3v1A10.66 10.66 0 0 1 3 4s-4 9 5 13a11.64 11.64 0 0 1-7 2c9 5 20 0 20-11.5a4.5 4.5 0 0 0-.08-.83A7.72 7.72 0 0 0 23 3z"></path>
            </svg>
          </a>
          <a href={`https://${empresa.redesSociales.facebook}`} target="_blank" rel="noopener noreferrer" class="p-3 transition-colors bg-white rounded-full shadow-md hover:bg-primary hover:text-white">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"></path>
            </svg>
          </a>
        </div>
      </div>
    </div>
    
    <div class="h-16"></div>
    
    <div class="grid grid-cols-1 lg:grid-cols-[1fr_350px] gap-8">
      <div class="space-y-8">
        <div class="p-8 border rounded-lg shadow-lg bg-white/80 backdrop-blur-xl border-white/20">
          <h2 class="flex items-center mb-4 text-xl font-semibold">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="mr-2 text-primary">
              <rect x="2" y="7" width="20" height="14" rx="2" ry="2"></rect>
              <path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"></path>
            </svg>
            Sobre nosotros
          </h2>
          
          <p class="mb-6 leading-relaxed text-text-light">
            {empresa.descripcion}
          </p>
          
          <div class="grid grid-cols-1 gap-6 md:grid-cols-3">
            <div>
              <h3 class="mb-2 font-semibold text-primary">Misión</h3>
              <p class="text-sm text-text-light">{empresa.mision}</p>
            </div>
            <div>
              <h3 class="mb-2 font-semibold text-primary">Visión</h3>
              <p class="text-sm text-text-light">{empresa.vision}</p>
            </div>
            <div>
              <h3 class="mb-2 font-semibold text-primary">Valores</h3>
              <ul class="pl-5 space-y-1 text-sm list-disc text-text-light">
                {empresa.valores.map((valor) => (
                  <li>{valor}</li>
                ))}
              </ul>
            </div>
          </div>
        </div>
        
        <div class="p-8 border rounded-lg shadow-lg bg-white/80 backdrop-blur-xl border-white/20">
          <div class="flex items-center justify-between mb-6">
            <h2 class="flex items-center text-xl font-semibold">
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="mr-2 text-primary">
                <rect x="2" y="7" width="20" height="14" rx="2" ry="2"></rect>
                <line x1="2" y1="11" x2="22" y2="11"></line>
              </svg>
              Vacantes disponibles
            </h2>
            
            <a href="/publicar-vacante" class="flex items-center text-sm font-medium text-primary hover:underline">
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="mr-1">
                <circle cx="12" cy="12" r="10"></circle>
                <line x1="12" y1="8" x2="12" y2="16"></line>
                <line x1="8" y1="12" x2="16" y2="12"></line>
              </svg>
              Publicar nueva vacante
            </a>
          </div>
          
          <div class="grid grid-cols-1 gap-6 md:grid-cols-2">
            {empresa.vacantes.map((job) => (
              <JobCard job={job} />
            ))}
          </div>
        </div>
        
        <div class="p-8 border rounded-lg shadow-lg bg-white/80 backdrop-blur-xl border-white/20">
          <h2 class="flex items-center mb-6 text-xl font-semibold">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="mr-2 text-primary">
              <polyline points="20 6 9 17 4 12"></polyline>
            </svg>
            Beneficios para empleados
          </h2>
          
          <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 md:grid-cols-3">
            {empresa.beneficios.map((beneficio) => (
              <div class="flex items-start">
                <div class="bg-primary/10 rounded-full p-2 mr-3 mt-0.5">
                  <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-primary">
                    <polyline points="20 6 9 17 4 12"></polyline>
                  </svg>
                </div>
                <span class="text-text-light">{beneficio}</span>
              </div>
            ))}
          </div>
        </div>
      </div>
      
      <div class="space-y-6">
        <div class="p-6 border rounded-lg shadow-lg bg-white/80 backdrop-blur-xl border-white/20">
          <h2 class="mb-4 text-lg font-semibold">Información de la empresa</h2>
          
          <div class="space-y-4">
            <div class="flex items-start">
              <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="mt-1 mr-3 text-primary">
                <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
                <circle cx="12" cy="10" r="3"></circle>
              </svg>
              <div>
                <p class="text-sm text-text-light">Ubicación</p>
                <p class="font-medium">{empresa.ubicacion}</p>
              </div>
            </div>
            
            <div class="flex items-start">
              <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="mt-1 mr-3 text-primary">
                <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path>
              </svg>
              <div>
                <p class="text-sm text-text-light">Teléfono</p>
                <p class="font-medium">{empresa.contacto.telefono}</p>
              </div>
            </div>
            
            <div class="flex items-start">
              <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="mt-1 mr-3 text-primary">
                <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
                <polyline points="22,6 12,13 2,6"></polyline>
              </svg>
              <div>
                <p class="text-sm text-text-light">Email</p>
                <p class="font-medium">{empresa.contacto.email}</p>
              </div>
            </div>
            
            <div class="flex items-start">
              <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="mt-1 mr-3 text-primary">
                <circle cx="12" cy="12" r="10"></circle>
                <line x1="2" y1="12" x2="22" y2="12"></line>
                <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"></path>
              </svg>
              <div>
                <p class="text-sm text-text-light">Sitio web</p>
                <a href={`https://${empresa.sitioWeb}`} target="_blank" rel="noopener noreferrer" class="font-medium text-primary hover:underline">{empresa.sitioWeb}</a>
              </div>
            </div>
            
            <div class="flex items-start">
              <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="mt-1 mr-3 text-primary">
                <rect x="2" y="7" width="20" height="14" rx="2" ry="2"></rect>
                <path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"></path>
              </svg>
              <div>
                <p class="text-sm text-text-light">Industria</p>
                <p class="font-medium">{empresa.industria}</p>
              </div>
            </div>
            
            <div class="flex items-start">
              <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="mt-1 mr-3 text-primary">
                <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
                <circle cx="9" cy="7" r="4"></circle>
                <path d="M23 21v-2a4 4 0 0 0-3-3.87"></path>
                <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
              </svg>
              <div>
                <p class="text-sm text-text-light">Tamaño</p>
                <p class="font-medium">{empresa.tamaño}</p>
              </div>
            </div>
            
            <div class="flex items-start">
              <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="mt-1 mr-3 text-primary">
                <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
                <line x1="16" y1="2" x2="16" y2="6"></line>
                <line x1="8" y1="2" x2="8" y2="6"></line>
                <line x1="3" y1="10" x2="21" y2="10"></line>
              </svg>
              <div>
                <p class="text-sm text-text-light">Fundación</p>
                <p class="font-medium">{empresa.fundacion}</p>
              </div>
            </div>
          </div>
        </div>
        
        <div class="p-6 border rounded-lg shadow-lg bg-white/80 backdrop-blur-xl border-white/20">
          <h2 class="mb-4 text-lg font-semibold">Contacto</h2>
          
          <form class="space-y-4">
            <div>
              <label for="nombre" class="block mb-1 text-sm font-medium text-text">Nombre</label>
              <input 
                type="text" 
                id="nombre" 
                name="nombre" 
                class="w-full px-4 py-2 border border-gray-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-primary/20 focus:border-primary" 
                required
              />
            </div>
            
            <div>
              <label for="email" class="block mb-1 text-sm font-medium text-text">Email</label>
              <input 
                type="email" 
                id="email" 
                name="email" 
                class="w-full px-4 py-2 border border-gray-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-primary/20 focus:border-primary" 
                required
              />
            </div>
            
            <div>
              <label for="mensaje" class="block mb-1 text-sm font-medium text-text">Mensaje</label>
              <textarea 
                id="mensaje" 
                name="mensaje" 
                rows="4" 
                class="w-full px-4 py-2 border border-gray-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-primary/20 focus:border-primary" 
                required
              ></textarea>
            </div>
            
            <button type="submit" class="w-full bg-gradient-primary text-white py-2 px-4 rounded-lg shadow-lg hover:shadow-xl transition-all duration-300 hover:-translate-y-0.5">
              Enviar mensaje
            </button>
          </form>
        </div>
      </div>
    </div>
  </div>

  <Footer slot="footer" />
</Layout>
