---
import Footer from "../../components/Footer.astro";
import Header from "../../components/Header.jsx";
import SobreMi from "../../components/SobreMi.jsx";
import Layout from "../../layouts/Layout.astro";
import "../../styles/pages/candidato.css";


const { id } = Astro.params;
console.log(id); // <-- Aquí ves el id
const res = await fetch(
    `http://localhost:8080/api/candidatos/perfil?idUsuario=${id}`,
    {
        credentials: "include",
    },
);

if (!res.ok) {
    throw new Error("Error al obtener el perfil");
}

const data = await res.json();
console.log(data); // <-- Aquí ves el objeto completo

const perfil = data;

const candidato = {
    nombre: "Carlos Rodríguez",
    titulo: "Desarrollador Frontend Senior",
    ubicacion: "Bogotá, Colombia",
    disponibilidad: "Disponible inmediatamente",
    foto: "/placeholder.svg?height=150&width=150&text=CR",
    resumen:
        "Desarrollador Frontend con más de 5 años de experiencia creando interfaces de usuario atractivas y funcionales. Especializado en React, TypeScript y arquitecturas modernas de frontend. Apasionado por la accesibilidad web y la experiencia de usuario.",
    educacion: [
        {
            titulo: "Ingeniería de Sistemas",
            institucion: "Universidad Nacional de Colombia",
            periodo: "2012 - 2016",
        },
        {
            titulo: "Bootcamp de Desarrollo Web",
            institucion: "Coding Academy",
            periodo: "2016",
        },
    ],
    habilidades: [
        "JavaScript",
        "TypeScript",
        "React",
        "Vue.js",
        "HTML5",
        "CSS3",
        "SASS",
        "Git",
        "Jest",
        "Webpack",
        "Responsive Design",
        "UI/UX",
        "Accesibilidad Web",
    ],
    idiomas: [
        { idioma: "Español", nivel: "Nativo" },
        { idioma: "Inglés", nivel: "Avanzado (C1)" },
        { idioma: "Portugués", nivel: "Intermedio (B1)" },
    ],
    contacto: {
        email: "carlos.rodriguez@ejemplo.com",
        telefono: "+57 300 123 4567",
        linkedin: "linkedin.com/in/carlosrodriguez",
        github: "github.com/carlosrodriguez",
        portfolio: "carlosrodriguez.dev",
    },
};
---

<Layout>
    <Header client:load />

    <div class="container mx-auto px-4 py-8">
        <div class="flex flex-col md:flex-row gap-6">
            <!-- Columna izquierda -->
            <div class="w-full md:w-1/3 lg:w-1/4">
                <div class="container px-4 py-8 mx-auto">
                    <div class="flex flex-col gap-8 md:flex-row">
                        {/* Columna Izquierda */}
                        <div class="w-full md:w-1/3 lg:w-1/4">
                            <div
                                class="p-6 mb-6 text-center bg-white border border-gray-100 rounded-lg shadow-sm"
                            >
                                <div class="relative w-32 h-32 mx-auto mb-4">
                                    <img
                                        src={perfil.candidato.imagen}
                                        alt={`${perfil.candidato.nombre} ${perfil.candidato.apellido}`}
                                        class="object-cover w-full h-full border-4 border-white rounded-full shadow-sm"
                                    />
                                    <div
                                        class="absolute w-4 h-4 bg-green-500 border-2 border-white rounded-full bottom-1 right-1"
                                    >
                                    </div>
                                </div>
                                <h1 class="mb-1 text-xl font-bold">
                                    {perfil.candidato.nombre}
                                    {perfil.candidato.apellido}
                                </h1>
                                <p class="mb-2 font-medium text-blue-600">
                                    {perfil.candidato.estudio}
                                </p>
                                <div
                                    class="flex items-center justify-center mb-3 text-sm text-gray-500"
                                >
                                    <svg
                                        xmlns="http://www.w3.org/2000/svg"
                                        width="16"
                                        height="16"
                                        viewBox="0 0 24 24"
                                        fill="none"
                                        stroke="currentColor"
                                        stroke-width="2"
                                        stroke-linecap="round"
                                        stroke-linejoin="round"
                                        class="mr-1"
                                    >
                                        <path
                                            d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"
                                        ></path>
                                        <circle cx="12" cy="10" r="3"></circle>
                                    </svg>
                                    {/* {perfil.candidato.ubicacion} */}
                                </div>
                            </div>
                        </div>

                        <div class="flex flex-col gap-8 md:flex-row"></div>
                    </div>
                </div>

                <!-- Disponibilidad
        <div class="inline-block px-3 py-1 mb-4 text-xs font-medium text-green-800 bg-green-100 rounded-full">
          {candidato.disponibilidad}
        </div> -->

                <!-- Botones de contacto -->
                <div class="flex justify-center gap-4 mb-4">
                    <a
                        href={`mailto:${perfil.candidato.correo}`}
                        class="text-gray-600 hover:text-blue-600"
                        aria-label="Email"
                    >
                        <!-- SVG Email -->
                    </a>
                    <a
                        href={`https://${candidato.contacto.linkedin}`}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="text-gray-600 hover:text-blue-600"
                        aria-label="LinkedIn"
                    >
                        <!-- SVG LinkedIn -->
                    </a>
                    <a
                        href={`https://${candidato.contacto.github}`}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="text-gray-600 hover:text-blue-600"
                        aria-label="GitHub"
                    >
                        <!-- SVG GitHub -->
                    </a>
                    <a
                        href={`https://${candidato.contacto.portfolio}`}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="text-gray-600 hover:text-blue-600"
                        aria-label="Portfolio"
                    >
                        <!-- SVG Portfolio -->
                    </a>
                </div>

                <!-- Botones de acción -->
                <div class="flex flex-col gap-2">
                    <a
                        href="#"
                        class="w-full px-4 py-2 font-medium text-center text-white transition-colors bg-blue-600 rounded-md hover:bg-blue-700"
                    >
                        Contactar
                    </a>
                    <button
                        class="w-full px-4 py-2 font-medium text-blue-600 transition-colors border border-blue-600 rounded-md hover:bg-blue-50"
                    >
                        Descargar CV
                    </button>
                </div>

                <!-- Habilidades -->
                <div
                    class="p-6 mb-6 bg-white border border-gray-100 rounded-lg shadow-sm"
                >
                    <h2 class="flex items-center mb-4 text-lg font-semibold">
                        <!-- SVG Habilidades -->
                        Habilidades
                    </h2>
                    <div class="flex flex-wrap gap-2">
                        {
                            candidato.habilidades.map((habilidad) => (
                                <span class="bg-gray-100 text-gray-800 text-xs font-medium px-2.5 py-1 rounded-md">
                                    {habilidad}
                                </span>
                            ))
                        }
                    </div>
                </div>

                <!-- Idiomas -->
                <div
                    class="p-6 bg-white border border-gray-100 rounded-lg shadow-sm"
                >
                    <h2 class="flex items-center mb-4 text-lg font-semibold">
                        <!-- SVG Idiomas -->
                        Idiomas
                    </h2>
                    <div class="space-y-3">
                        {
                            candidato.idiomas.map((idioma) => (
                                <div>
                                    <div class="flex justify-between mb-1">
                                        <span class="text-sm font-medium">
                                            {idioma.idioma}
                                        </span>
                                        <span class="text-xs text-gray-500">
                                            {idioma.nivel}
                                        </span>
                                    </div>
                                </div>
                            ))
                        }
                    </div>
                </div>
            </div>
            <div class="w-full md:w-2/3 lg:w-3/4">
                Sobre mí
                <div
                    class="relative p-6 mb-6 bg-white border border-gray-100 rounded-lg shadow-sm"
                >
                    <button
                        id="editProfileBtn"
                        class="absolute p-2 text-white transition-all duration-300 bg-blue-600 rounded-full shadow-sm top-4 right-4 hover:bg-blue-700 hover:scale-110"
                        aria-label="Editar perfil"
                    >
                        <SobreMi client:load />

                        Columna derecha
                        <div class="w-full md:w-2/3 lg:w-3/4">
                            Sobre mí
                            <div
                                class="relative p-6 mb-6 bg-white border border-gray-100 rounded-lg shadow-sm"
                            >
                                <button
                                    id="editProfileBtn"
                                    class="absolute p-2 text-white transition-all duration-300 bg-blue-600 rounded-full shadow-sm top-4 right-4 hover:bg-blue-700 hover:scale-110"
                                    aria-label="Editar perfil"
                                >
                                    SVG Editar
                                </button>
                                <h2
                                    class="flex items-center mb-4 text-xl font-semibold"
                                >
                                    SVG Perfil Sobre mí
                                </h2>
                                <p class="text-gray-600">
                                    {perfil.candidato.descripcion}
                                </p>
                            </div> -->

                            <div
                                class="p-6 bg-white border border-gray-100 rounded-lg shadow-sm"
                            >
                                <h2
                                    class="flex items-center mb-6 text-xl font-semibold"
                                >
                                    SVG Educación Educación
                                </h2>
                                <div class="space-y-8">
                                    {
                                        candidato.educacion.map((edu) => (
                                            <div class="flex">
                                                <div class="mt-1 mr-4">
                                                    <div class="w-1 h-full bg-gray-200" />
                                                    <div class="w-3 h-3 bg-blue-600 rounded-full" />
                                                </div>
                                                <div>
                                                    <h3 class="text-lg font-medium">
                                                        {edu.titulo}
                                                    </h3>
                                                    <div class="flex items-center text-sm text-gray-500">
                                                        <span>
                                                            {edu.institucion}
                                                        </span>
                                                        <span class="mx-2">
                                                            •
                                                        </span>
                                                        <span>
                                                            {edu.periodo}
                                                        </span>
                                                    </div>
                                                </div>
                                            </div>
                                        ))
                                    }
                                </div>
                            </div>
                        </div>
                    </button>
                </div> -->

                <Footer slot="footer" />
            </div>
        </div>
    </div></Layout
>
