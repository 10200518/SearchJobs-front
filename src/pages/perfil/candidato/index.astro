---
import Footer from "../../../components/Footer.astro";
import Header from "../../../components/Header.jsx";
import Layout from "../../../layouts/Layout.astro";
import "../../../styles/perfiles/candidato.css";
import { manejarRespuesta } from '../../../javascripts/ManejarRespuesta';


const res = await fetch("http://localhost:8080/api/candidatos/perfil", {
  headers: Astro.request.headers,
});

interface Experiencia {
  cargo: string;
  empresa: string;
  periodo: string;
  descripcion: string;
}

interface Estudio {
  titulo: string;
  institucion: string;
  periodo: string;
  descripcion: string;
}

const data = await manejarRespuesta(res); 
const candidato = data.candidato;
const estudios = data.estudios;
const historrialLaboral = data.historialLaboral;
---
<Layout>
  <Header client:load />

  <div class="candidato-perfil-container">
    <div class="candidato-perfil">
      <!-- Cabecera del perfil -->
      <div class="candidato-perfil-header">
        <!-- Imagen de perfil -->
        <div class="candidato-imagen-container">
          <img
            src={candidato.imagen ? "http://localhost:8080" + candidato.imagen : "http://localhost:8080/images/imgCandidato.png"}
            alt={`${candidato.nombre} ${candidato.apellido}`}
            class="candidato-imagen"
          />
        </div>

        <!-- Información del encabezado -->
        <div class="candidato-header-info">
          <h1 class="candidato-nombre">
            {candidato.nombre}
            {candidato.apellido}
          </h1>
          <p class="candidato-cargo">Falta un cargo</p>
        </div>

        <!-- Botones de acción -->
        <div class="candidato-header-actions">
          <button id="editProfileBtn" class="candidato-edit-button">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path
                d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"
              ></path>
              <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"
              ></path>
            </svg>
            Editar perfil
          </button>

          <a href={"http://localhost:8080"+candidato.curriculo || "#"} class="candidato-cv-button">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
              <polyline points="7 10 12 15 17 10"></polyline>
              <line x1="12" y1="15" x2="12" y2="3"></line>
            </svg>
            Descargar CV
          </a>
        </div>
      </div>

      <!-- Contenido del perfil -->
      <div class="candidato-perfil-content">
        <!-- Información de contacto -->
        <div class="candidato-info-grid">
          <div class="candidato-info-item">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path
                d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"
              ></path>
              <polyline points="22,6 12,13 2,6"></polyline>
            </svg>
            <div class="candidato-info-content">
              <span class="candidato-info-label">Correo</span>
              <span class="candidato-info-value">{candidato.correo}</span>
            </div>
          </div>

          <div class="candidato-info-item">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path
                d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"
              ></path>
            </svg>
            <div class="candidato-info-content">
              <span class="candidato-info-label">Teléfono</span>
              <span class="candidato-info-value">{candidato.telefono || "No registrado"}</span>
            </div>
          </div>
        </div>

        <!-- Sección de descripción -->
        <div class="candidato-section">
          <h2 class="candidato-section-title">Descripción</h2>
          <p class="candidato-descripcion">
            {candidato.descripcion || "No se ha registrado una descripcion"}
          </p>
        </div>

        <!-- Sección de estudios -->
        <div class="candidato-section">
          <h2 class="candidato-section-title">Estudios</h2>
          <div class="candidato-timeline">
            {
              estudios.length === 0 ? (
                <p>No hay estudios disponibles</p>
              ) : (
                estudios.map((estudio:Estudio) => (
                  <div class="candidato-timeline-item">
                    <div class="candidato-timeline-dot" />
                    <h3 class="candidato-timeline-title">{estudio.titulo}</h3>
                    <p class="candidato-timeline-subtitle">
                      {estudio.institucion}
                    </p>
                    <p class="candidato-timeline-period">{estudio.periodo}</p>
                    <p class="candidato-timeline-description">
                      {estudio.descripcion}
                    </p>
                  </div>
                ))
              )
            }
          </div>
        </div>

        <!-- Sección de historial laboral -->
        <div class="candidato-section">
          <h2 class="candidato-section-title">Historial Laboral</h2>
          <div class="candidato-timeline">
            {
              historrialLaboral.length === 0 ? (
                <p>No hay historial laboral disponible</p>
              ) : (
                historrialLaboral.map((exp:Experiencia) => (
                  <div class="candidato-timeline-item">
                    <div class="candidato-timeline-dot" />
                    <h3 class="candidato-timeline-title">{exp.cargo}</h3>
                    <p class="candidato-timeline-subtitle">{exp.empresa}</p>
                    <p class="candidato-timeline-period">{exp.periodo}</p>
                    <p class="candidato-timeline-description">
                      {exp.descripcion}
                    </p>
                  </div>
                ))
              )
            }
          </div>
        </div>
      </div>
    </div>
  </div> 

  <Footer slot="footer" />
</Layout>

<script type="text/javascript">
  document.addEventListener("DOMContentLoaded", function () {

    const editBtn = document.getElementById("editProfileBtn");
    const cvButton = document.querySelector(".candidato-cv-button");

    if (editBtn) {
      editBtn.addEventListener("click", () => {
        alert("Aquí se abriría el formulario para editar el perfil");
      });
    }
    
    const candidato = {
      curriculo: null, 
    };
    
    if (candidato.curriculo) {
      cvButton.classList.remove("disabled"); 
    } else {
      cvButton.classList.add("disabled");
      cvButton.addEventListener("click", function (e) {
        e.preventDefault();  
      });
    }
  });
</script>
