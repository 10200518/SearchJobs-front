---
import Footer from "../../../components/Footer.astro";
import Header from "../../../components/Header.jsx";
import Layout from "../../../layouts/Layout.astro";
import "../../../styles/perfiles/candidato.css";

const { id } = Astro.params;
const apiUrl = `http://localhost:8080/api/candidatos/perfil?idUsuario=${id}`;
const updateUrl = `http://localhost:8080/api/candidatos/actualizar`;

interface Experiencia {
  id?: string;
  cargo: string;
  empresa: string;
  periodo: string;
  descripcion: string;
}

interface Estudio {
  id?: string;
  titulo: string;
  institucion: string;
  periodo: string;
  descripcion: string;
}

const res = await fetch(apiUrl, {
  headers: Astro.request.headers,
});

const data = await res.json();
const candidato = data.candidato || {};
const estudios = data.estudios || [];
const historialLaboral = data.historialLaboral || [];
---

<Layout title={`Editar Perfil | SearchJobs`}>
  <Header client:load />

  <div class="candidato-perfil-container">
    <form class="candidato-perfil candidato-editar-form" method="POST" action={updateUrl} enctype="multipart/form-data">
      <input type="hidden" name="idUsuario" value={id} />
      
      <!-- Cabecera del perfil -->
      <div class="candidato-perfil-header">
        <!-- Imagen de perfil -->
        <div class="candidato-imagen-container">
          <img
            src={candidato.imagen ? `${import.meta.env.API_URL || 'http://localhost:8080'}${candidato.imagen}` : `${import.meta.env.API_URL || 'http://localhost:8080'}/images/imgCandidato.png`}
            alt={`${candidato.nombre} ${candidato.apellido}`}
            class="candidato-imagen"
            id="foto-preview"
          />
          <label for="foto-upload" class="candidato-imagen-upload">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="12" cy="12" r="3"></circle>
              <path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"></path>
            </svg>
            Cambiar foto
            <input 
              type="file" 
              id="foto-upload" 
              name="imagen" 
              accept="image/*" 
              style="display: none;"
            />
          </label>
        </div>

        <!-- Información del encabezado -->
        <div class="candidato-header-info">
          <div class="form-group">
            <input
              type="text"
              id="nombre"
              name="nombre"
              value={candidato.nombre}
              class="candidato-nombre-input"
              placeholder="Nombre"
              required
            />
            <input
              type="text"
              id="apellido"
              name="apellido"
              value={candidato.apellido}
              class="candidato-nombre-input"
              placeholder="Apellido"
              required
            />
          </div>
          <input
            type="text"
            id="cargo"
            name="cargo"
            value={candidato.cargo || ""}
            class="candidato-cargo-input"
            placeholder="Tu cargo/profesión"
          />
        </div>

        <!-- Subir CV -->
        <div class="candidato-cv-upload">
          <label for="curriculo-upload" class="candidato-cv-button">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
              <polyline points="7 10 12 15 17 10"></polyline>
              <line x1="12" y1="15" x2="12" y2="3"></line>
            </svg>
            {candidato.curriculo ? "Cambiar CV" : "Subir CV"}
            <input 
              type="file" 
              id="curriculo-upload" 
              name="curriculo" 
              accept=".pdf,.doc,.docx"
              style="display: none;"
            />
          </label>
          {candidato.curriculo && (
            <a href={`${import.meta.env.API_URL || 'http://localhost:8080'}${candidato.curriculo}`} class="candidato-cv-link" target="_blank">
              Ver CV actual
            </a>
          )}
        </div>
      </div>

      <!-- Contenido del perfil -->
      <div class="candidato-perfil-content">
        <!-- Información de contacto -->
        <div class="candidato-info-grid">
          <div class="candidato-info-item">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path
                d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"
              ></path>
              <polyline points="22,6 12,13 2,6"></polyline>
            </svg>
            <div class="candidato-info-content">
              <span class="candidato-info-label">Correo</span>
              <input
                type="email"
                id="correo"
                name="correo"
                value={candidato.correo}
                class="candidato-info-input"
                placeholder="Correo electrónico"
                required
              />
            </div>
          </div>

          <div class="candidato-info-item">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path
                d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"
              ></path>
            </svg>
            <div class="candidato-info-content">
              <span class="candidato-info-label">Teléfono</span>
              <input
                type="tel"
                id="telefono"
                name="telefono"
                value={candidato.telefono || ""}
                class="candidato-info-input"
                placeholder="Teléfono"
              />
            </div>
          </div>
        </div>

        <!-- Sección de descripción -->
        <div class="candidato-section">
          <h2 class="candidato-section-title">Descripción</h2>
          <textarea
            id="descripcion"
            name="descripcion"
            class="candidato-descripcion-input"
            placeholder="Cuéntanos sobre ti, tus habilidades y experiencia..."
          >{candidato.descripcion || ""}</textarea>
        </div>

        <!-- Sección de estudios -->
        <div class="candidato-section">
          <div class="candidato-section-header">
            <h2 class="candidato-section-title">Estudios</h2>
            <button type="button" class="candidato-add-button" id="add-estudio-btn">
              + Añadir estudio
            </button>
          </div>
          <div class="candidato-timeline" id="estudios-container">
            {estudios.length === 0 ? (
              <p>No hay estudios registrados</p>
            ) : (
              estudios.map((estudio: Estudio, index: number) => (
                <div class="candidato-timeline-item estudio-item">
                  <input type="hidden" name={`estudios[${index}][id]`} value={estudio.id || ''} />
                  <div class="candidato-timeline-dot" />
                  <input
                    type="text"
                    name={`estudios[${index}][titulo]`}
                    value={estudio.titulo}
                    class="candidato-timeline-input"
                    placeholder="Título obtenido"
                    required
                  />
                  <input
                    type="text"
                    name={`estudios[${index}][institucion]`}
                    value={estudio.institucion}
                    class="candidato-timeline-input"
                    placeholder="Institución educativa"
                    required
                  />
                  <input
                    type="text"
                    name={`estudios[${index}][periodo]`}
                    value={estudio.periodo}
                    class="candidato-timeline-input"
                    placeholder="Periodo (ej. 2015-2019)"
                    required
                  />
                  <textarea
                    name={`estudios[${index}][descripcion]`}
                    class="candidato-timeline-textarea"
                    placeholder="Descripción del estudio"
                  >{estudio.descripcion}</textarea>
                  <button type="button" class="candidato-remove-button" data-type="estudio">
                    Eliminar
                  </button>
                </div>
              ))
            )}
          </div>
        </div>

        <!-- Sección de historial laboral -->
        <div class="candidato-section">
          <div class="candidato-section-header">
            <h2 class="candidato-section-title">Historial Laboral</h2>
            <button type="button" class="candidato-add-button" id="add-experiencia-btn">
              + Añadir experiencia
            </button>
          </div>
          <div class="candidato-timeline" id="experiencias-container">
            {historialLaboral.length === 0 ? (
              <p>No hay experiencia laboral registrada</p>
            ) : (
              historialLaboral.map((exp: Experiencia, index: number) => (
                <div class="candidato-timeline-item experiencia-item">
                  <input type="hidden" name={`experiencias[${index}][id]`} value={exp.id || ''} />
                  <div class="candidato-timeline-dot" />
                  <input
                    type="text"
                    name={`experiencias[${index}][cargo]`}
                    value={exp.cargo}
                    class="candidato-timeline-input"
                    placeholder="Cargo ocupado"
                    required
                  />
                  <input
                    type="text"
                    name={`experiencias[${index}][empresa]`}
                    value={exp.empresa}
                    class="candidato-timeline-input"
                    placeholder="Empresa"
                    required
                  />
                  <input
                    type="text"
                    name={`experiencias[${index}][periodo]`}
                    value={exp.periodo}
                    class="candidato-timeline-input"
                    placeholder="Periodo (ej. 2018-2020)"
                    required
                  />
                  <textarea
                    name={`experiencias[${index}][descripcion]`}
                    class="candidato-timeline-textarea"
                    placeholder="Descripción de tus responsabilidades y logros"
                  >{exp.descripcion}</textarea>
                  <button type="button" class="candidato-remove-button" data-type="experiencia">
                    Eliminar
                  </button>
                </div>
              ))
            )}
          </div>
        </div>

        <!-- Botones de acción -->
        <div class="candidato-form-actions">
          <button type="submit" class="candidato-save-button">
            Guardar cambios
          </button>
          <a href={`/perfil/candidato/${id}`} class="candidato-cancel-button">
            Cancelar
          </a>
        </div>
      </div>
    </form>
  </div>

  <Footer slot="footer" />
</Layout>

  <script type="js">
    // Función para previsualizar la imagen seleccionada
    function previewImage(input, previewId) {
      const preview = document.getElementById(previewId);
      const file = input.files[0];
      const reader = new FileReader();
      
      reader.onload = function(e) {
        preview.src = e.target.result;
      }
      
      if (file) {
        reader.readAsDataURL(file);
      }
    }

    // Contadores para nuevos estudios y experiencias
    let estudioCounter = estudios.length;
    let experienciaCounter = historialLaboral.length;

    // Añadir nuevo estudio
    function addEstudio() {
      const container = document.getElementById('estudios-container');
      const newItem = document.createElement('div');
      newItem.className = 'candidato-timeline-item estudio-item';
      newItem.innerHTML = `
        <input type="hidden" name="estudios[${estudioCounter}][id]" value="new" />
        <div class="candidato-timeline-dot" />
        <input
          type="text"
          name="estudios[${estudioCounter}][titulo]"
          class="candidato-timeline-input"
          placeholder="Título obtenido"
          required
        />
        <input
          type="text"
          name="estudios[${estudioCounter}][institucion]"
          class="candidato-timeline-input"
          placeholder="Institución educativa"
          required
        />
        <input
          type="text"
          name="estudios[${estudioCounter}][periodo]"
          class="candidato-timeline-input"
          placeholder="Periodo (ej. 2015-2019)"
          required
        />
        <textarea
          name="estudios[${estudioCounter}][descripcion]"
          class="candidato-timeline-textarea"
          placeholder="Descripción del estudio"
        ></textarea>
        <button type="button" class="candidato-remove-button" onclick="removeItem(this, 'estudio')">
          Eliminar
        </button>
      `;
      container.appendChild(newItem);
      estudioCounter++;
    }

    // Añadir nueva experiencia
    function addExperiencia() {
      const container = document.getElementById('experiencias-container');
      const newItem = document.createElement('div');
      newItem.className = 'candidato-timeline-item experiencia-item';
      newItem.innerHTML = `
        <input type="hidden" name="experiencias[${experienciaCounter}][id]" value="new" />
        <div class="candidato-timeline-dot" />
        <input
          type="text"
          name="experiencias[${experienciaCounter}][cargo]"
          class="candidato-timeline-input"
          placeholder="Cargo ocupado"
          required
        />
        <input
          type="text"
          name="experiencias[${experienciaCounter}][empresa]"
          class="candidato-timeline-input"
          placeholder="Empresa"
          required
        />
        <input
          type="text"
          name="experiencias[${experienciaCounter}][periodo]"
          class="candidato-timeline-input"
          placeholder="Periodo (ej. 2018-2020)"
          required
        />
        <textarea
          name="experiencias[${experienciaCounter}][descripcion]"
          class="candidato-timeline-textarea"
          placeholder="Descripción de tus responsabilidades y logros"
        ></textarea>
        <button type="button" class="candidato-remove-button" onclick="removeItem(this, 'experiencia')">
          Eliminar
        </button>
      `;
      container.appendChild(newItem);
      experienciaCounter++;
    }

    // Eliminar item
    function removeItem(button, type) {
      const item = button.closest(`.${type}-item`);
      item.remove();
      
      // Reindexar los elementos restantes
      const container = type === 'estudio' 
        ? document.getElementById('estudios-container') 
        : document.getElementById('experiencias-container');
      
      const items = container.querySelectorAll(`.${type}-item`);
      items.forEach((item, index) => {
        const inputs = item.querySelectorAll('input, textarea');
        inputs.forEach(input => {
          const name = input.name.replace(/\[\d+\]/, `[${index}]`);
          input.name = name;
        });
      });
      
      if (type === 'estudio') {
        estudioCounter = items.length;
      } else {
        experienciaCounter = items.length;
      }
    }
  </script>