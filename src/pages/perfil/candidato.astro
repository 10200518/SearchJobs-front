---
import Footer from "../../components/Footer.astro";
import Header from "../../components/Header.jsx";
import PerfilCliente from "../../components/PerfilCliente.jsx";
import SobreMi from "../../components/SobreMi.jsx";
import Layout from "../../layouts/Layout.astro";
import "../../styles/pages/candidato.css";

const candidato = {
  nombre: "Carlos Rodríguez",
  titulo: "Desarrollador Frontend Senior",
  ubicacion: "Bogotá, Colombia",
  disponibilidad: "Disponible inmediatamente",
  foto: "/placeholder.svg?height=150&width=150&text=CR",
  resumen:
    "Desarrollador Frontend con más de 5 años de experiencia creando interfaces de usuario atractivas y funcionales. Especializado en React, TypeScript y arquitecturas modernas de frontend. Apasionado por la accesibilidad web y la experiencia de usuario.",
  educacion: [
    {
      titulo: "Ingeniería de Sistemas",
      institucion: "Universidad Nacional de Colombia",
      periodo: "2012 - 2016",
    },
    {
      titulo: "Bootcamp de Desarrollo Web",
      institucion: "Coding Academy",
      periodo: "2016",
    },
  ],
  habilidades: [
    "JavaScript",
    "TypeScript",
    "React",
    "Vue.js",
    "HTML5",
    "CSS3",
    "SASS",
    "Git",
    "Jest",
    "Webpack",
    "Responsive Design",
    "UI/UX",
    "Accesibilidad Web",
  ],
  idiomas: [
    { idioma: "Español", nivel: "Nativo" },
    { idioma: "Inglés", nivel: "Avanzado (C1)" },
    { idioma: "Portugués", nivel: "Intermedio (B1)" },
  ],
  contacto: {
    email: "carlos.rodriguez@ejemplo.com",
    telefono: "+57 300 123 4567",
    linkedin: "linkedin.com/in/carlosrodriguez",
    github: "github.com/carlosrodriguez",
    portfolio: "carlosrodriguez.dev",
  },
};
---

<Layout>
  <Header client:load />

  <div class="container mx-auto px-4 py-8">
    <div class="flex flex-col md:flex-row gap-6">
      <!-- Columna izquierda -->
      <div class="w-full md:w-1/3 lg:w-1/4">
        <PerfilCliente client:load />

        <!-- Disponibilidad
        <div class="inline-block px-3 py-1 mb-4 text-xs font-medium text-green-800 bg-green-100 rounded-full">
          {candidato.disponibilidad}
        </div> -->

        <!-- Botones de contacto -->
        <div class="flex justify-center gap-4 mb-4">
          <a href={`mailto:${candidato.contacto.email}`} class="text-gray-600 hover:text-blue-600" aria-label="Email">
            <!-- SVG Email -->
          </a>
          <a href={`https://${candidato.contacto.linkedin}`} target="_blank" rel="noopener noreferrer" class="text-gray-600 hover:text-blue-600" aria-label="LinkedIn">
            <!-- SVG LinkedIn -->
          </a>
          <a href={`https://${candidato.contacto.github}`} target="_blank" rel="noopener noreferrer" class="text-gray-600 hover:text-blue-600" aria-label="GitHub">
            <!-- SVG GitHub -->
          </a>
          <a href={`https://${candidato.contacto.portfolio}`} target="_blank" rel="noopener noreferrer" class="text-gray-600 hover:text-blue-600" aria-label="Portfolio">
            <!-- SVG Portfolio -->
          </a>
        </div>

        <!-- Botones de acción -->
        <div class="flex flex-col gap-2">
          <a href="#" class="w-full px-4 py-2 font-medium text-center text-white transition-colors bg-blue-600 rounded-md hover:bg-blue-700">
            Contactar
          </a>
          <button class="w-full px-4 py-2 font-medium text-blue-600 transition-colors border border-blue-600 rounded-md hover:bg-blue-50">
            Descargar CV
          </button>
        </div>

        <!-- Habilidades -->
        <div class="p-6 mb-6 bg-white border border-gray-100 rounded-lg shadow-sm">
          <h2 class="flex items-center mb-4 text-lg font-semibold">
            <!-- SVG Habilidades -->
            Habilidades
          </h2>
          <div class="flex flex-wrap gap-2">
            {candidato.habilidades.map((habilidad) => (
              <span class="bg-gray-100 text-gray-800 text-xs font-medium px-2.5 py-1 rounded-md">
                {habilidad}
              </span>
            ))}
          </div>
        </div>

        <!-- Idiomas -->
        <div class="p-6 bg-white border border-gray-100 rounded-lg shadow-sm">
          <h2 class="flex items-center mb-4 text-lg font-semibold">
            <!-- SVG Idiomas -->
            Idiomas
          </h2>
          <div class="space-y-3">
            {candidato.idiomas.map((idioma) => (
              <div>
                <div class="flex justify-between mb-1">
                  <span class="text-sm font-medium">{idioma.idioma}</span>
                  <span class="text-xs text-gray-500">{idioma.nivel}</span>
                </div>
              </div>
            ))}
          </div>
        </div>
      </div>
      <div class="w-full md:w-2/3 lg:w-3/4">
        Sobre mí 
       <div class="relative p-6 mb-6 bg-white border border-gray-100 rounded-lg shadow-sm">
