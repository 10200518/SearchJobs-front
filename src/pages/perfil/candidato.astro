---
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";

const candidato = {
  nombre: "Carlos Rodríguez",
  titulo: "Desarrollador Frontend Senior",
  ubicacion: "Bogotá, Colombia",
  disponibilidad: "Disponible inmediatamente",
  foto: "/placeholder.svg?height=150&width=150&text=CR",
  resumen:
    "Desarrollador Frontend con más de 5 años de experiencia creando interfaces de usuario atractivas y funcionales. Especializado en React, TypeScript y arquitecturas modernas de frontend. Apasionado por la accesibilidad web y la experiencia de usuario.",
  experiencia: [
    {
      puesto: "Desarrollador Frontend Senior",
      empresa: "TechSolutions",
      periodo: "Enero 2021 - Presente",
      descripcion:
        "Desarrollo de aplicaciones web con React y TypeScript. Implementación de arquitecturas escalables y mantenibles. Liderazgo técnico de un equipo de 3 desarrolladores.",
    },
    {
      puesto: "Desarrollador Frontend",
      empresa: "WebInnovate",
      periodo: "Marzo 2018 - Diciembre 2020",
      descripcion:
        "Desarrollo de interfaces de usuario con Vue.js. Implementación de diseños responsivos y accesibles. Colaboración con equipos de diseño y backend.",
    },
    {
      puesto: "Desarrollador Web Junior",
      empresa: "DigitalCreative",
      periodo: "Junio 2016 - Febrero 2018",
      descripcion:
        "Desarrollo de sitios web con HTML, CSS y JavaScript. Implementación de diseños responsivos. Mantenimiento de sitios web existentes.",
    },
  ],
  educacion: [
    {
      titulo: "Ingeniería de Sistemas",
      institucion: "Universidad Nacional de Colombia",
      periodo: "2012 - 2016",
    },
    {
      titulo: "Bootcamp de Desarrollo Web",
      institucion: "Coding Academy",
      periodo: "2016",
    },
  ],
  habilidades: [
    "JavaScript",
    "TypeScript",
    "React",
    "Vue.js",
    "HTML5",
    "CSS3",
    "SASS",
    "Git",
    "Jest",
    "Webpack",
    "Responsive Design",
    "UI/UX",
    "Accesibilidad Web",
  ],
  idiomas: [
    { idioma: "Español", nivel: "Nativo" },
    { idioma: "Inglés", nivel: "Avanzado (C1)" },
    { idioma: "Portugués", nivel: "Intermedio (B1)" },
  ],
  certificaciones: [
    {
      nombre: "React Advanced Patterns",
      emisor: "Frontend Masters",
      fecha: "2022",
    },
    {
      nombre: "Web Accessibility",
      emisor: "Google",
      fecha: "2021",
    },
  ],
  proyectos: [
    {
      nombre: "E-commerce Dashboard",
      descripcion: "Panel de administración para tiendas online con análisis de datos y gestión de inventario.",
      tecnologias: ["React", "TypeScript", "Redux", "Chart.js"],
    },
    {
      nombre: "Travel App",
      descripcion: "Aplicación para planificar viajes con mapas interactivos y recomendaciones personalizadas.",
      tecnologias: ["Vue.js", "Vuex", "Mapbox", "Node.js"],
    },
  ],
  contacto: {
    email: "carlos.rodriguez@ejemplo.com",
    telefono: "+57 300 123 4567",
    linkedin: "linkedin.com/in/carlosrodriguez",
    github: "github.com/carlosrodriguez",
    portfolio: "carlosrodriguez.dev",
  },
}
---

<Layout title={`Perfil de ${candidato.nombre} | SearchJobs`}>
    <Header slot="header" />
    
    <div class="container px-4 py-10 mx-auto">
      <div class="mb-8 overflow-hidden border shadow-lg bg-white/80 backdrop-blur-xl rounded-xl border-white/20">
        <div class="relative h-32 bg-gradient-primary md:h-48"></div>
        
        <div class="relative px-6 pb-6">
          <div class="flex flex-col items-start gap-6 mb-6 -mt-16 md:flex-row md:items-end md:-mt-20">
            <div class="w-32 h-32 overflow-hidden bg-white border-4 border-white rounded-full shadow-lg md:w-40 md:h-40">
              <img src={candidato.foto || "/placeholder.svg"} alt={candidato.nombre} class="object-cover w-full h-full" />
            </div>
            
            <div class="flex-1">
              <div class="flex flex-col justify-between gap-4 md:flex-row md:items-center">
                <div>
                  <h1 class="text-2xl font-bold md:text-3xl">{candidato.nombre}</h1>
                  <p class="text-lg font-medium text-primary">{candidato.titulo}</p>
                  <div class="flex items-center gap-2 mt-1 text-text-light">
                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
                      <circle cx="12" cy="10" r="3"></circle>
                    </svg>
                    <span>{candidato.ubicacion}</span>
                  </div>
                </div>
                
                <div class="flex gap-3">
                  <a href="#" class="flex items-center gap-2 px-4 py-2 text-sm rounded-lg btn-primary">
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                      <polyline points="7 10 12 15 17 10"></polyline>
                      <line x1="12" y1="15" x2="12" y2="3"></line>
                    </svg>
                    Descargar CV
                  </a>
                  <a href="#" class="flex items-center gap-2 px-4 py-2 text-sm rounded-lg btn-outline">
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
                      <polyline points="22,6 12,13 2,6"></polyline>
                    </svg>
                    Contactar
                  </a>
                </div>
              </div>
              
              <div class="flex flex-wrap gap-2 mt-4">
                <span class="px-3 py-1 text-sm font-medium rounded-full bg-primary/10 text-primary">
                  {candidato.disponibilidad}
                </span>
              </div>
            </div>
          </div>
        </div>
      </div>
      
      <div class="grid grid-cols-1 gap-8 lg:grid-cols-3">
        <div class="lg:col-span-2">
          <div class="p-6 mb-8 border shadow-lg bg-white/80 backdrop-blur-xl rounded-xl border-white/20">
            <h2 class="flex items-center gap-2 mb-4 text-xl font-bold text-primary">
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="12" r="10"></circle>
                <line x1="12" y1="8" x2="12" y2="12"></line>
                <line x1="12" y1="16" x2="12.01" y2="16"></line>
              </svg>
              Sobre mí
            </h2>
            <p class="leading-relaxed text-text-light">{candidato.resumen}</p>
          </div>
          
          <div class="p-6 mb-8 border shadow-lg bg-white/80 backdrop-blur-xl rounded-xl border-white/20">
            <h2 class="flex items-center gap-2 mb-6 text-xl font-bold text-primary">
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <rect x="2" y="7" width="20" height="14" rx="2" ry="2"></rect>
                <path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"></path>
              </svg>
              Experiencia
            </h2>
            
            <div class="space-y-8">
              {candidato.experiencia.map((exp, index) => (
                <div class="relative pb-8 pl-8 border-l-2 border-primary/20 last:border-0 last:pb-0">
                  <div class="absolute left-[-8px] top-0 w-4 h-4 rounded-full bg-primary"></div>
                  <h3 class="text-lg font-semibold">{exp.puesto}</h3>
                  <div class="flex items-center gap-2 mb-2 text-primary">
                    <span>{exp.empresa}</span>
                    <span class="w-1 h-1 rounded-full bg-primary/50"></span>
                    <span class="text-sm">{exp.periodo}</span>
                  </div>
                  <p class="text-text-light">{exp.descripcion}</p>
                </div>
              ))}
            </div>
          </div>
          
          <div class="p-6 mb-8 border shadow-lg bg-white/80 backdrop-blur-xl rounded-xl border-white/20">
            <h2 class="flex items-center gap-2 mb-6 text-xl font-bold text-primary">
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M22 10v6M2 10l10-5 10 5-10 5z"></path>
                <path d="M6 12v5c3 3 9 3 12 0v-5"></path>
              </svg>
              Educación
            </h2>
            
            <div class="space-y-6">
              {candidato.educacion.map((edu) => (
                <div class="relative pb-6 pl-8 border-l-2 border-primary/20 last:border-0 last:pb-0">
                  <div class="absolute left-[-8px] top-0 w-4 h-4 rounded-full bg-primary"></div>
                  <h3 class="text-lg font-semibold">{edu.titulo}</h3>
                  <div class="flex items-center gap-2 text-primary">
                    <span>{edu.institucion}</span>
                    <span class="w-1 h-1 rounded-full bg-primary/50"></span>
                    <span class="text-sm">{edu.periodo}</span>
                  </div>
                </div>
              ))}
            </div>
          </div>
          
          <div class="p-6 mb-8 border shadow-lg bg-white/80 backdrop-blur-xl rounded-xl border-white/20 lg:mb-0">
            <h2 class="flex items-center gap-2 mb-6 text-xl font-bold text-primary">
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon>
              </svg>
              Proyectos destacados
            </h2>
            
            <div class="space-y-6">
              {candidato.proyectos.map((proyecto) => (
                <div class="p-4 transition-colors rounded-lg bg-primary/5 hover:bg-primary/10">
                  <h3 class="text-lg font-semibold">{proyecto.nombre}</h3>
                  <p class="mb-3 text-text-light">{proyecto.descripcion}</p>
                  <div class="flex flex-wrap gap-2">
                    {proyecto.tecnologias.map((tech) => (
                      <span class="px-2 py-1 text-xs font-medium bg-white rounded text-primary">{tech}</span>
                    ))}
                  </div>
                </div>
              ))}
            </div>
          </div>
        </div>
        
        <div>
          <div class="p-6 mb-8 border shadow-lg bg-white/80 backdrop-blur-xl rounded-xl border-white/20">
            <h2 class="flex items-center gap-2 mb-4 text-xl font-bold text-primary">
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <line x1="22" y1="12" x2="2" y2="12"></line>
                <path d="M5.45 5.11L2 12v6a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2v-6l-3.45-6.89A2 2 0 0 0 16.76 4H7.24a2 2 0 0 0-1.79 1.11z"></path>
                <line x1="6" y1="16" x2="6.01" y2="16"></line>
                <line x1="10" y1="16" x2="10.01" y2="16"></line>
              </svg>
              Habilidades
            </h2>
            
            <div class="flex flex-wrap gap-2">
              {candidato.habilidades.map((habilidad) => (
                <span class="px-3 py-1 text-sm rounded-full bg-primary/10 text-primary">{habilidad}</span>
              ))}
            </div>
          </div>
          
          <!-- Idiomas -->
          <div class="p-6 mb-8 border shadow-lg bg-white/80 backdrop-blur-xl rounded-xl border-white/20">
            <h2 class="flex items-center gap-2 mb-4 text-xl font-bold text-primary">
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M21.54 15a2 2 0 0 1-1.76 3H8.24a2 2 0 0 1-1.79-1.11L2 7l6-5h14l-4.47 10H21l.54 3z"></path>
              </svg>
              Idiomas
            </h2>
            
            <div class="space-y-3">
              {candidato.idiomas.map((idioma) => (
                <div class="flex items-center justify-between">
                  <span class="font-medium">{idioma.idioma}</span>
                  <span class="text-sm text-text-light">{idioma.nivel}</span>
                </div>
              ))}
            </div>
          </div>
          
          <!-- Certificaciones -->
          <div class="p-6 mb-8 border shadow-lg bg-white/80 backdrop-blur-xl rounded-xl border-white/20">
            <h2 class="flex items-center gap-2 mb-4 text-xl font-bold text-primary">
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="8" r="7"></circle>
                <polyline points="8.21 13.89 7 23 12 20 17 23 15.79 13.88"></polyline>
              </svg>
              Certificaciones
            </h2>
            
            <div class="space-y-4">
              {candidato.certificaciones.map((cert) => (
                <div>
                  <h3 class="font-medium">{cert.nombre}</h3>
                  <div class="flex items-center gap-2 text-sm text-text-light">
                    <span>{cert.emisor}</span>
                    <span class="w-1 h-1 rounded-full bg-text-light"></span>
                    <span>{cert.fecha}</span>
                  </div>
                </div>
              ))}
            </div>
          </div>
          
          <!-- Contacto -->
          <div class="p-6 border shadow-lg bg-white/80 backdrop-blur-xl rounded-xl border-white/20">
            <h2 class="flex items-center gap-2 mb-4 text-xl font-bold text-primary">
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
                <polyline points="22,6 12,13 2,6"></polyline>
              </svg>
              Contacto
            </h2>
            
            <div class="space-y-3">
              <div class="flex items-center gap-3">
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-primary">
                  <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
                  <polyline points="22,6 12,13 2,6"></polyline>
                </svg>
                <a href={`mailto:${candidato.contacto.email}`} class="transition-colors text-text-light hover:text-primary">
                  {candidato.contacto.email}
                </a>
              </div>
              
              <div class="flex items-center gap-3">
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-primary">
                  <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path>
                </svg>
                <a href={`tel:${candidato.contacto.telefono}`} class="transition-colors text-text-light hover:text-primary">
                  {candidato.contacto.telefono}
                </a>
              </div>
              
              <div class="flex items-center gap-3">
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-primary">
                  <path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"></path>
                  <rect x="2" y="9" width="4" height="12"></rect>
                  <circle cx="4" cy="4" r="2"></circle>
                </svg>
                <a href={`https://${candidato.contacto.linkedin}`} target="_blank" class="transition-colors text-text-light hover:text-primary">
                  {candidato.contacto.linkedin}
                </a>
              </div>
              
              <div class="flex items-center gap-3">
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-primary">
                  <path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22"></path>
                </svg>
                <a href={`https://${candidato.contacto.github}`} target="_blank" class="transition-colors text-text-light hover:text-primary">
                  {candidato.contacto.github}
                </a>
              </div>
              
              <div class="flex items-center gap-3">
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-primary">
                  <circle cx="12" cy="12" r="10"></circle>
                  <line x1="2" y1="12" x2="22" y2="12"></line>
                  <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"></path>
                </svg>
                <a href={`https://${candidato.contacto.portfolio}`} target="_blank" class="transition-colors text-text-light hover:text-primary">
                  {candidato.contacto.portfolio}
                </a>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
    
    <Footer slot="footer" />
  </Layout>
  