---
import Footer from "../../../components/Footer.astro";
import Header from "../../../components/Header.jsx";
import Layout from "../../../layouts/Layout.astro";
import "../../../styles/perfiles/empresa.css";

const { id } = Astro.params;

const apiUrl = `http://localhost:8080/api/empresas/perfil`;
const updateUrl = `http://localhost:8080/api/empresas/actualizar`;

const res = await fetch(apiUrl, {
  headers: Astro.request.headers,
});

const data = await res.json();
const empresa = data.empresa || {};
---


<Layout title={`Editar ${empresa.nombre} | SearchJobs`}>
    <Header client:load />

      <div class="empresa-perfil-container">
    <form class="empresa-perfil empresa-editar-form" method="POST" action={updateUrl} enctype="multipart/form-data">
      <input type="hidden" name="idUsuario" value={id} />
      
      <!-- Cabecera del perfil -->
      <div class="empresa-perfil-header">
        <!-- Logo de la empresa -->
        <div class="empresa-logo-container">
          <img 
            src={empresa.imagen ? "http://localhost:8080" + empresa.imagen : "http://localhost:8080/images/imgEmpresa.png"}
            alt={empresa.nombre} 
            class="empresa-logo"
            id="logo-preview"
          />
          <label for="logo-upload" class="empresa-logo-upload">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="12" cy="12" r="3"></circle>
              <path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"></path>
            </svg>
            Cambiar logo
            <input 
              type="file" 
              id="logo-upload" 
              name="imagen" 
              accept="image/*" 
              style="display: none;"
              onchange="previewImage(this, 'logo-preview')"
            />
          </label>
        </div>
        
        <!-- Información del encabezado -->
        <div class="empresa-header-info">
          <div class="form-group">
            <input 
              type="text" 
              id="nombre" 
              name="nombre" 
              value={empresa.nombre} 
              class="empresa-nombre-input" 
              placeholder="Nombre de la empresa"
              required
            />
          </div>
          <div class="form-group">
            <input 
              type="text" 
              id="sectorEmpresarial" 
              name="sectorEmpresarial" 
              value={empresa.sectorEmpresarial} 
              class="empresa-sector-input" 
              placeholder="Sector empresarial"
              required
            />
          </div>
        </div>
      </div>
      
      <!-- Contenido del perfil -->
      <div class="empresa-perfil-content">
        <!-- Información de contacto -->
        <div class="empresa-info-grid">
          <div class="empresa-info-item">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
              <line x1="16" y1="2" x2="16" y2="6"></line>
              <line x1="8" y1="2" x2="8" y2="6"></line>
              <line x1="3" y1="10" x2="21" y2="10"></line>
            </svg>
            <div class="empresa-info-content">
              <span class="empresa-info-label">NIT</span>
              <input 
                type="text" 
                id="nit" 
                name="nit" 
                value={empresa.nit} 
                class="empresa-info-input" 
                placeholder="NIT de la empresa"
                required
              />
            </div>
          </div>
          
          <div class="empresa-info-item">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
              <polyline points="22,6 12,13 2,6"></polyline>
            </svg>
            <div class="empresa-info-content">
              <span class="empresa-info-label">Correo</span>
              <input 
                type="email" 
                id="correo" 
                name="correo" 
                value={empresa.correo} 
                class="empresa-info-input" 
                placeholder="Correo electrónico"
                required
              />
            </div>
          </div>
          
          <div class="empresa-info-item">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path>
            </svg>
            <div class="empresa-info-content">
              <span class="empresa-info-label">Teléfono</span>
              <input 
                type="tel" 
                id="telefono" 
                name="telefono" 
                value={empresa.telefono || ""} 
                class="empresa-info-input" 
                placeholder="Teléfono de contacto"
              />
            </div>
          </div>
          
          <div class="empresa-info-item">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="12" cy="12" r="10"></circle>
              <line x1="2" y1="12" x2="22" y2="12"></line>
              <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"></path>
            </svg>
            <div class="empresa-info-content">
              <span class="empresa-info-label">Sitio Web</span>
              <input 
                type="url" 
                id="sitioWeb" 
                name="sitioWeb" 
                value={empresa.sitioWeb || ""} 
                class="empresa-info-input" 
                placeholder="Sitio web (ejemplo.com)"
              />
            </div>
          </div>
        </div>
        
        <!-- Sección de descripción -->
        <div class="empresa-descripcion-section">
          <h2 class="empresa-section-title">Descripción</h2>
          <textarea 
            id="descripcion" 
            name="descripcion" 
            class="empresa-descripcion-input" 
            placeholder="Describe tu empresa, su misión, visión y valores..."
          >{empresa.descripcion || ""}</textarea>
        </div>
        
        <!-- Botones de acción -->
        <div class="empresa-form-actions">
          <button type="submit" class="empresa-save-button">
            Guardar cambios
          </button>
          <a href="/perfil/empresa/" class="empresa-cancel-button">
            Cancelar
          </a>
        </div>
      </div>
    </form>
  </div>

    <Footer client:load />
</Layout>

  <script type="js">
    // Función para previsualizar la imagen seleccionada
    function previewImage(input, previewId) {
      const preview = document.getElementById(previewId);
      const file = input.files[0];
      const reader = new FileReader();
      
      reader.onload = function(e) {
        preview.src = e.target.result;
      }
      
      if (file) {
        reader.readAsDataURL(file);
      }
    }
  </script>
  