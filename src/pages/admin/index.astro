---
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Header.jsx";
import Footer from "../../components/Footer.astro";
import AdminSidebar from "../../components/AdminSidebar.astro";

const stats = {
  vacantesActivas: 245,
  vacantesDesactivadas: 32,
  usuariosActivos: 1250,
  usuariosBaneados: 15,
  empresasActivas: 87,
  postulacionesHoy: 124,
};
---

<Layout title="Panel de Administrador | SearchJobs">
  <Header client:load /><br>

  <div class="container px-4 py-6 mx-auto mt-12">
    <div class="flex flex-col gap-6 md:flex-row">
      <AdminSidebar activeItem="dashboard" />

      <div class="flex-1">
        <h1 class="mb-6 text-2xl font-bold">Panel de Administrador</h1>

        <div class="grid grid-cols-1 gap-4 mb-8 sm:grid-cols-2 lg:grid-cols-3">
          <div class="p-4 bg-white border border-gray-100 rounded-lg shadow-sm">
            <div class="flex items-center">
              <div class="p-3 mr-4 text-blue-600 bg-blue-100 rounded-full">
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  width="24"
                  height="24"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <rect x="2" y="7" width="20" height="14" rx="2" ry="2"></rect>
                  <path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"></path>
                </svg>
              </div>
              <div>
                <p class="text-sm text-gray-500">Vacantes Activas</p>
                <p class="text-xl font-semibold">{stats.vacantesActivas}</p>
              </div>
            </div>
          </div>

          <div class="p-4 bg-white border border-gray-100 rounded-lg shadow-sm">
            <div class="flex items-center">
              <div class="p-3 mr-4 text-red-600 bg-red-100 rounded-full">
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  width="24"
                  height="24"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <rect x="2" y="7" width="20" height="14" rx="2" ry="2"></rect>
                  <line x1="2" y1="11" x2="22" y2="11"></line>
                </svg>
              </div>
              <div>
                <p class="text-sm text-gray-500">Vacantes Desactivadas</p>
                <p class="text-xl font-semibold">
                  {stats.vacantesDesactivadas}
                </p>
              </div>
            </div>
          </div>

          <div class="p-4 bg-white border border-gray-100 rounded-lg shadow-sm">
            <div class="flex items-center">
              <div class="p-3 mr-4 text-green-600 bg-green-100 rounded-full">
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  width="24"
                  height="24"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
                  <circle cx="12" cy="7" r="4"></circle>
                </svg>
              </div>
              <div>
                <p class="text-sm text-gray-500">Usuarios Activos</p>
                <p class="text-xl font-semibold">{stats.usuariosActivos}</p>
              </div>
            </div>
          </div>

          <div class="p-4 bg-white border border-gray-100 rounded-lg shadow-sm">
            <div class="flex items-center">
              <div class="p-3 mr-4 text-orange-600 bg-orange-100 rounded-full">
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  width="24"
                  height="24"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <path d="M17 14l-5 5-5-5"></path>
                  <path d="M12 9V3"></path>
                  <path d="M12 19v2"></path>
                </svg>
              </div>
              <div>
                <p class="text-sm text-gray-500">Usuarios Baneados</p>
                <p class="text-xl font-semibold">{stats.usuariosBaneados}</p>
              </div>
            </div>
          </div>

          <div class="p-4 bg-white border border-gray-100 rounded-lg shadow-sm">
            <div class="flex items-center">
              <div class="p-3 mr-4 text-purple-600 bg-purple-100 rounded-full">
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  width="24"
                  height="24"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <rect x="2" y="7" width="20" height="14" rx="2" ry="2"></rect>
                  <path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"></path>
                </svg>
              </div>
              <div>
                <p class="text-sm text-gray-500">Empresas Activas</p>
                <p class="text-xl font-semibold">{stats.empresasActivas}</p>
              </div>
            </div>
          </div>

          <div class="p-4 bg-white border border-gray-100 rounded-lg shadow-sm">
            <div class="flex items-center">
              <div class="p-3 mr-4 text-teal-600 bg-teal-100 rounded-full">
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  width="24"
                  height="24"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <polyline points="22 12 18 12 15 21 9 3 6 12 2 12"></polyline>
                </svg>
              </div>
              <div>
                <p class="text-sm text-gray-500">Postulaciones Hoy</p>
                <p class="text-xl font-semibold">{stats.postulacionesHoy}</p>
              </div>
            </div>
          </div>
        </div>

        <div class="p-6 mb-8 bg-white border border-gray-200 rounded-2xl shadow-md">
          <h2 class="mb-6 text-2xl font-bold text-gray-800">📊 Análisis de Datos</h2>
          
          <div class="relative w-full overflow-hidden rounded-xl shadow-inner aspect-video bg-gray-200 hover:shadow-lg transition-shadow">
            <iframe
              title="Dashboard Power BI"
              class="w-full h-full border-0 rounded-xl"
              src="https://app.powerbi.com/view?r=eyJrIjoiNzdhMWQzZmItOWNlZC00ZTY4LWE3YzItMWNiNDI4Y2IyOGM5IiwidCI6IjlkMTJiZjNmLWU0ZjYtNDdhYi05MTJmLTFhMmYwZmM0OGFhNCIsImMiOjR9"
              allowfullscreen
            ></iframe>
          </div>
        </div>

      </div>
    </div>
  </div>

  <Footer slot="footer" />
</Layout>

<script>
  document.addEventListener("DOMContentLoaded", () => {
    const configurePowerBIBtn = document.getElementById("configurePowerBI");

    if (configurePowerBIBtn) {
      configurePowerBIBtn.addEventListener("click", () => {
        alert(
          "Aquí se abriría un formulario para configurar la integración con Power BI.",
        );
      });
    }
  });
</script>
