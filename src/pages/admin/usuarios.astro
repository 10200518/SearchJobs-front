      </div>
      
      <div class="flex justify-end gap-3">
        <button id="cancelar-banear" class="px-4 py-2 text-gray-700 transition-colors border border-gray-300 rounded-md hover:bg-gray-50">Cancelar</button>
        <button id="confirmar-banear" class="px-4 py-2 text-white transition-colors bg-red-600 rounded-md hover:bg-red-700">Banear</button>
      </div>
    </div>
