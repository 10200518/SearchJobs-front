---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.jsx';
import Footer from '../../components/Footer.astro';
import '../../styles/pages/empresa.css';
---

<Layout title="Registro de Empresa | SearchJobs">
  <Header client:load />
  
  <main class="max-w-screen-md px-4 py-8 mx-auto">
    <h1 class="mb-2 text-2xl font-bold text-center text-transparent bg-gradient-to-r from-blue-600 to-blue-400 bg-clip-text">Registro de Empresa</h1>
    <p class="mb-8 text-center text-gray-600">Completa el formulario para comenzar a publicar vacantes y encontrar talento</p>
    
    <div class="bg-white border border-gray-100 rounded-lg shadow-sm">
      <form id="empresaForm" class="p-6">
        <!-- Nombre de la empresa -->
        <div class="mb-6">
          <label for="nombreEmpresa" class="block mb-1 text-sm font-medium text-gray-700">
            Nombre de la empresa <span class="text-red-500">*</span>
          </label>
          <input 
            type="text" 
            id="nombreEmpresa" 
            name="nombreEmpresa" 
            placeholder="Nombre legal de la empresa"
            class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-1 focus:ring-blue-500" 
            required
          />
        </div>
        
        <div class="grid grid-cols-1 gap-6 mb-6 md:grid-cols-2">
          <!-- NIT / Identificación fiscal -->
          <div>
            <label for="nit" class="block mb-1 text-sm font-medium text-gray-700">
              NIT / Identificación fiscal <span class="text-red-500">*</span>
            </label>
            <input 
              type="text" 
              id="nombreEmpresa" 
              name="nombre" 
              class="form-control" 
              placeholder="Nombre legal de la empresa" 
              required
            />
            <p class="hidden error-text" id="error-nombre"></p>
          </div>
          
          <div class="form-row">
            <div class="form-group">
              <label for="nit">NIT / Identificación fiscal <span class="required">*</span></label>
              <input 
                type="text" 
                id="nit" 
                name="nit" 
                class="form-control" 
                placeholder="Número de identificación tributaria" 
                required
              />
              <p class="hidden error-text" id="error-nit"></p>
            </div>
            <div class="form-group">
              <label for="sectorEmpresa">Sector Empresa <span class="required">*</span></label>
              <select id="sectorEmpresa" name="sectorEmpresa" class="form-control" required>
                <option value="" disabled selected>Selecciona tu sector</option>
                <option value="tecnologia">Tecnología</option>
                <option value="finanzas">Finanzas</option>
                <option value="manufactura">Manufactura</option>
                <option value="salud">Salud</option>
              </select>
            </div>
          </div>
          
          <div class="form-group">
            <label for="emailEmpresa">Correo electrónico corporativo <span class="required">*</span></label>
            <input 
              type="email" 
              id="emailEmpresa" 
              name="correo" 
              class="form-control" 
              placeholder="ejemplo@empresa.com" 
              required
            />
            <p class="form-hint">Usarás este correo para iniciar sesión</p>
            <p class="hidden error-text" id="error-correo"></p>
          </div>

          <div class="form-group">
            <label for="telefonoEmpresa">Teléfono corporativo <span class="required">*</span></label>
            <input 
              type="tel" 
              id="telefonoEmpresa" 
              name="telefono" 
              class="form-control" 
              placeholder="+57 601 123 4567" 
              required
            />
            <p class="hidden error-text" id="error-telefono"></p>
          </div>

          <div class="form-row">
            <div class="form-group">
              <label for="passwordEmpresa">Contraseña <span class="required">*</span></label>
              <div class="password-input">
                <input 
                  type="password" 
                  id="passwordEmpresa" 
                  name="passwordEmpresa" 
                  class="form-control" 
                  placeholder="Crea una contraseña segura" 
                  required
                />
                <button type="button" class="password-toggle">
                  <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path>
                    <circle cx="12" cy="12" r="3"></circle>
                  </svg>
                </button>
              </div>
            </div>
            
            <div class="form-group">
              <label for="confirmPasswordEmpresa">Confirmar contraseña <span class="required">*</span></label>
              <div class="password-input">
                <input 
                  type="password" 
                  id="confirmPasswordEmpresa" 
                  name="confirmPasswordEmpresa" 
                  class="form-control" 
                  placeholder="Repite tu contraseña" 
                  required
                />
                <button type="button" class="password-toggle">
                  <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path>
                    <circle cx="12" cy="12" r="3"></circle>
                  </svg>
                </button>
              </div>
            </div>
          </div>
          
          <div class="password-requirements">
            <p class="requirements-title">La contraseña debe contener:</p>
            <ul>
              <li id="req-length">Al menos 8 caracteres</li>
              <li id="req-uppercase">Al menos una letra mayúscula</li>
              <li id="req-lowercase">Al menos una letra minúscula</li>
              <li id="req-number">Al menos un número</li>
              <li id="req-match">Las contraseñas deben coincidir</li>
            </ul>
          </div>

          <div class="terms-container">
            <h3>Términos y condiciones</h3>
            <div class="terms-content">
              <p>Al registrarte como empresa en SearchJobs, aceptas:</p>
              <ol>
                <li>Publicar únicamente ofertas laborales reales</li>
                <li>Mantener información veraz y actualizada</li>
                <li>Cumplir con las leyes laborales de tu país</li>
              </ol>
            </div>
          </div>
          
          <div class="checkbox-group">
            <input type="checkbox" id="aceptoTerminos" required />
            <label for="aceptoTerminos">Acepto los términos y condiciones <span class="required">*</span></label>
          </div>
          
          <div class="step-buttons">
            <button type="button" class="btn btn-outline" id="btnCancelar">Cancelar</button>
            <button type="submit" class="btn btn-primary">Completar registro</button>

            <!-- <button type="button" class="btn btn-primary" id="btnSiguiente">Siguiente</button> -->
          </div>
        </div>
        
