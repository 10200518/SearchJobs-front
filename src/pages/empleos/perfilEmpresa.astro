---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import '../../styles/pages/perfilempresa.css';

// Datos simulados (estos serán reemplazados con los datos del backend en producción)
const empresa = {
  nombre: 'Empresa XYZ',
  descripcion: 'Empresa líder en soluciones tecnológicas.',
  sector: 'Tecnología',
  nit: '1234567890',
  sitioWeb: 'http://www.empresa.xyz',
  telefono: '+57 3001234567',
  correo: 'contacto@empresa.xyz',
  imagenPerfil: '/img/empresa-perfil.png'
};
---

<Layout title="Perfil de Empresa">
  <Header slot="header" />

  <main class="perfil-empresa-container">
    <h1>📄 Perfil de Empresa</h1>

    <div class="perfil-card">
      <div class="imagen-contenedor">
        <img src={empresa.imagenPerfil} alt="Imagen de perfil de la empresa" />
      </div>

      <div class="datos-contenedor">
        <p><strong>🏢 Nombre:</strong> {empresa.nombre}</p>
        <p><strong>📝 Descripción:</strong> {empresa.descripcion}</p>
        <p><strong>🏷️ Sector:</strong> {empresa.sector}</p>
        <p><strong>🧾 NIT:</strong> {empresa.nit}</p>
        <p><strong>🌐 Sitio Web:</strong> <a href={empresa.sitioWeb} target="_blank">{empresa.sitioWeb}</a></p>
        <p><strong>📞 Teléfono:</strong> {empresa.telefono}</p>
        <p><strong>📧 Correo:</strong> <a href={`mailto:${empresa.correo}`}>{empresa.correo}</a></p>
      </div>
    </div>

    <a href="editarEmpresa" class="btn-editar-perfil">✏️ Editar Perfil</a>
  </main>

  <Footer slot="footer" />
</Layout>
