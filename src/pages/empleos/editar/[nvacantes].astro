---
import Layout from '../../../layouts/Layout.astro';
import Header from '../../../components/Header.jsx';
import Footer from '../../../components/Footer.astro';
import '../../../styles/pages/editarVacante.css';

const { nvacantes } = Astro.params;

const res = await fetch(`http://localhost:8080/api/vacantes/seleccion/${nvacantes}`);
const data = await res.json();
const vacante = data.vacanteSeleccionada;
console.log(vacante)
---

<Layout title="Editar Vacante">
  <Header slot="header" />
  
  <div class="vacante-form-container">
    <h1 class="vacante-form-title">Modificar Vacante</h1>
    <p class="vacante-form-subtitle">Edita los campos</p>
    
    {vacante ? (
      <form class="vacante-form" id="editarForm">
        <input type="hidden" name="nvacantes" value={vacante.nvacantes} />
        
        <!-- Primera fila -->
        <div class="form-row">
          <div class="form-group">
            <label for="titulo">Título del Puesto</label>
            <input type="text" id="titulo" name="titulo" value={vacante.titulo} required>
          </div>
        </div>
    
        <!-- Segunda fila -->
        <div class="form-row">
          <div class="form-group">
            <label for="ubicacion">Ciudad</label>
            <input type="text" id="ubicacion" name="ciudad" value={vacante.ciudad} required>
          </div>
          <div class="form-group">
            <label for="departamento">Departamento</label>
            <input type="text" id="departamento" name="departamento" value={vacante.departamento} required>
          </div>
          <div class="form-group">
            <label for="fecha">Fecha de Publicación</label>
            <input type="date" id="fecha" name="fechaPublicacion" 
                   value={vacante.fechaPublicacion?.split('T')[0] || ''} required>
          </div>
        </div>
    
        <!-- Tercera fila -->
        <div class="form-row">
          <div class="form-group">
            <label for="contrato">Tipo de Contrato</label>
            <select id="contrato" name="tipo" required>
              <option value="" disabled>Seleccionar</option>
              <option value="Tiempo completo" selected={vacante.tipo === 'Tiempo completo'}>🕐Tiempo completo</option>
              <option value="Medio tiempo" selected={vacante.tipo === 'Medio tiempo'}>⏳Medio tiempo</option>
              <option value="Temporal" selected={vacante.tipo === 'Temporal'}>📆Temporal</option>
            </select>
          </div>
          <div class="form-group">
            <label for="modalidad">Modalidad</label>
            <select id="modalidad" name="modalidad" required>
              <option value="" disabled>Seleccionar</option>
              <option value="Presencial" selected={vacante.modalidad === 'Presencial'}>🏢Presencial</option>
              <option value="Remoto" selected={vacante.modalidad === 'Remoto'}>🏠Remoto</option>
              <option value="Híbrido" selected={vacante.modalidad === 'Híbrido'}>🔀Híbrido</option>
            </select>
          </div>
          <div class="form-group">
            <label for="sueldo">Sueldo</label>
            <input type="number" id="sueldo" name="sueldo" value={vacante.sueldo} step="0.01">
          </div>
        </div>
    
        <!-- Cuarta fila -->
        <div class="form-row">
          <div class="form-group">
            <label for="cargo">Cargo</label>
            <input type="text" id="cargo" name="cargo" value={vacante.cargo} required>
          </div>
          <div class="form-group">
            <label for="experiencia">Experiencia</label>
            <input type="text" id="experiencia" name="experiencia" value={vacante.experiencia}>
          </div>
        </div>
    
        <!-- Descripción -->
        <div class="form-row">
          <div class="form-group full-width">
            <label for="descripcion">📄Descripción del Puesto</label>
            <textarea id="descripcion" name="descripcion" required>{vacante.descripcion}</textarea>
          </div>
        </div>
        
        <!-- Requerimientos -->
        <div class="form-row">
          <div class="form-group full-width">
            <label for="requerimientos">📝Requerimientos</label>
            <textarea id="requerimientos" name="requerimientos">{vacante.requerimientos}</textarea>
          </div>
        </div>
        
        <div class="form-actions">
          <button type="button" class="btn btn-cancel" id="cancelBtn">Cancelar</button>
          <button type="submit" class="btn btn-submit">Guardar Cambios</button>
        </div>
      </form>
    ) : (
      <p>No se pudo cargar la vacante. Por favor, intenta nuevamente.</p>
    )}
  </div>

  <Footer slot="footer" />

  <script is:inline>
    document.addEventListener('DOMContentLoaded', () => {
      const form = document.getElementById('editarForm');
      const cancelBtn = document.getElementById('cancelBtn');
      
      if (form) {
        form.addEventListener('submit', async (e) => {
          e.preventDefault();
          
          const formData = new FormData(form);
          const data = Object.fromEntries(formData.entries());
          
          try {
            const response = await fetch(`http://localhost:8080/api/vacantes/edit/${data.nvacantes}`, {
              method: 'PUT',
              headers: {
                'Content-Type': 'application/json',
              },
              body: JSON.stringify(data),
              credentials: 'include'
            });
            
            if (response.ok) {
              alert('Vacante actualizada correctamente');
              window.location.href = '/listadoVacantes';
            } else {
              const error = await response.json();
              alert(`Error al actualizar: ${error.message || 'Error desconocido'}`);
            }
          } catch (error) {
            console.error('Error:', error);
            alert('Error al conectar con el servidor');
          }
        });
      }
      
      if (cancelBtn) {
        cancelBtn.addEventListener('click', () => {
          window.location.href = '/empleos/listadoVacantes';
        });
      }
    });
  </script>
</Layout>
