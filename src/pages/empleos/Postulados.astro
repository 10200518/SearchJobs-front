---
// Importaciones de Astro y componentes
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.jsx';
import Footer from '../../components/Footer.astro';
import '../../styles/pages/postulados.css';
const vacanteId = 1;
---
<Layout title="SearchJobs | Postulados">
  <Header client:load />

  <section class="pagina">
    <h1>Postulados</h1>
    <p>Lista de candidatos que han aplicado a vacantes.</p>

    <table class="tabla">
      <thead>
        <tr>
          <th>Nombre</th>
          <th>Vacante</th>
          <th>Fecha de postulación</th>
          <th>Estado</th>
          <th>Currículum Vitae</th>
          <th>Perfil</th>
          <th>Chat</th>
        </tr>
      </thead>
      <tbody id="postulados-body">
        Filas generadas dinámicamente 
      </tbody>
    </table>
  </section>

  <script is:inline>
    const vacanteId = 1; // <-- Ajusta según cómo obtengas este ID
    let currentPage = 1;
    const itemsPerPage = 5;

    const cargarPostulados = async () => {
      try {
        const res = await fetch(`http://localhost:8080/api/postulados/lista/${vacanteId}?page=${currentPage - 1}&size=${itemsPerPage}`, {
          credentials: "include"
        });

        if (!res.ok) throw new Error("Error al cargar postulados");

        const data = await res.json();
        const postulados = data.postulados;
        const totalPages = data.totalPage;
        console.log(data.postulados)

        const tbody = document.getElementById("postulados-body");
        tbody.innerHTML = "";

        postulados.forEach(postulado => {
          const tr = document.createElement("tr");

          tr.innerHTML = `
            <td>${postulado.candidato.nombre}</td>
            <td>${postulado.vacante.titulo}</td>
            <td>${postulado.fechaPostulacion || '-'}</td>
            <td>${postulado.estado || 'Pendiente'}</td>
            <td><a href="${postulado.candidato.curriculo}" target="_blank" class="cv-link">Ver CV</a></td>
            <td><a href="/perfil/${postulado.candidato.id}">Ver perfil</a></td>
            <td>
              <button 
                class="abrir-chat-btn" 
                data-candidato-id="${postulado.candidatoId}" 
                data-vacante-id="${postulado.vacante.id}">
                Abrir chat
              </button>
            </td>
          `;
          tbody.appendChild(tr);
        });

        prepararChatButtons();

        document.getElementById("page-number").textContent = `Página ${currentPage}`;
        document.getElementById("prev").disabled = currentPage === 1;
        document.getElementById("next").disabled = currentPage === totalPages;

      } catch (err) {
        console.error("❌ Error al cargar postulados:", err);
      }
    };

    const prepararChatButtons = () => {
      document.querySelectorAll('.abrir-chat-btn').forEach(btn => {
        btn.addEventListener('click', async (e) => {
          const candidatoId = "27" //e.target.dataset.candidatoId;
          const vacanteId = "1" //e.target.dataset.vacanteId;

          try {
            const response = await fetch('http://localhost:8080/api/chats/crear', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ candidatoId, vacanteId })
            });

            if (!response.ok) throw new Error("Error al crear o buscar el chat");

            const chat = await response.json();
            window.location.href = `/chat/${chat.id}`;
          } catch (err) {
            console.error("Error al abrir el chat:", err);
            alert("No se pudo abrir el chat.");
          }
        });
      });
    };

    document.addEventListener('DOMContentLoaded', () => {
      // Botones paginación
      const paginacion = document.createElement('div');
      paginacion.className = 'pagination';

      const prevButton = document.createElement('button');
      prevButton.textContent = 'Anterior';
      prevButton.className = 'btn-pagina';
      prevButton.id = 'prev';

      const pageNumber = document.createElement('span');
      pageNumber.id = 'page-number';

      const nextButton = document.createElement('button');
      nextButton.textContent = 'Siguiente';
      nextButton.className = 'btn-pagina';
      nextButton.id = 'next';

      paginacion.appendChild(prevButton);
      paginacion.appendChild(pageNumber);
      paginacion.appendChild(nextButton);
      document.querySelector('.pagina').appendChild(paginacion);

      prevButton.addEventListener('click', () => {
        if (currentPage > 1) {
          currentPage--;
          cargarPostulados();
        }
      });

      nextButton.addEventListener('click', () => {
        currentPage++;
        cargarPostulados();
      });

      // Cargar la primera página
      cargarPostulados();
    });
  </script>

  <Footer />
</Layout> 


