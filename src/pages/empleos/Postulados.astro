  <script is:inline>
    let currentPage = 1;
    const itemsPerPage = 5;
  
    document.addEventListener('DOMContentLoaded', () => {
      const filas = document.querySelectorAll('.tabla tbody tr');
      const totalPages = Math.ceil(filas.length / itemsPerPage);
  
      // Crear controles de paginación
      const paginacion = document.createElement('div');
      paginacion.className = 'pagination';
  
      const prevButton = document.createElement('button');
      prevButton.textContent = 'Anterior';
      prevButton.className = 'btn-pagina';
      prevButton.id = 'prev';
  
      const pageNumber = document.createElement('span');
      pageNumber.id = 'page-number';
      pageNumber.textContent = `Página ${currentPage}`;
  
      const nextButton = document.createElement('button');
      nextButton.textContent = 'Siguiente';
      nextButton.className = 'btn-pagina';
      nextButton.id = 'next';
  
      paginacion.appendChild(prevButton);
      paginacion.appendChild(pageNumber);
      paginacion.appendChild(nextButton);
  
      document.querySelector('.pagina').appendChild(paginacion);
  
      const updateFilas = () => {
        const start = (currentPage - 1) * itemsPerPage;
        const end = start + itemsPerPage;
  
        filas.forEach((fila, index) => {
          fila.style.display = (index >= start && index < end) ? 'table-row' : 'none';
        });
        
        pageNumber.textContent = `Página ${currentPage}`;
        //esto lo que hace es deshabilitar el boton de anterior si estamos en la primera pagina y el de siguiente si estamos en la ultima siuuuu
        prevButton.disabled = currentPage === 1;
        nextButton.disabled = currentPage === totalPages;

      };
  
      prevButton.addEventListener('click', () => {
        if (currentPage > 1) {
          currentPage--;
          updateFilas();
        }
      });
  
      nextButton.addEventListener('click', () => {
        if (currentPage < totalPages) {
          currentPage++;
          updateFilas();
        }
      });
  
      updateFilas();
    });
  </script>
  

  <Footer />
</Layout>
