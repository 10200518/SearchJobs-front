--- 
import Footer from "../../components/Footer.astro";
import Header from "../../components/Header.astro";

import JobBoard from "../../components/JobBoard.jsx";
import Layout from "../../layouts/Layout.astro";
import "../../styles/pages/empleos.css";
---

<Layout title="Empleos | SearchJobs">
  <Header slot="header" />

  <div class="container">
    <div class="page-header">
      <h1 class="page-title">Encuentra tu próximo empleo</h1>
      <p class="page-description">
        Explora todas las oportunidades laborales disponibles
      </p>
    </div>

    <div class="search-container">
      <form class="search-form">
        <div class="search-input-group">
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="20"
            height="20"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="search-icon"
          >
            <circle cx="11" cy="11" r="8"></circle>
            <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
          </svg>
          
          <input
            type="text"
            placeholder="Cargo, habilidad o palabra clave"
            class="search-input"  
          />
        </div>
        <div class="search-input-group">
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="20"
            height="20"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="search-icon"
          >
            <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
            <circle cx="12" cy="10" r="3"></circle>
          </svg>
          <input
            type="text"
            placeholder="Ciudad o 'Remoto'"
            class="search-input"
          />
        </div>
        <button type="submit" class="btn btn-primary search-button">
          Buscar
        </button>
      </form>
    </div>

    <div class="content-container">
      <JobBoard client:load />
    </div>
  </div>
  <Footer slot="footer" />
</Layout>
