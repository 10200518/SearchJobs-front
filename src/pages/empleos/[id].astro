---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.jsx';
import Footer from '../../components/Footer.astro';

interface Vacante {
  nvacantes: string;  
  titulo: string;
  nameEmpresa: string;
  ciudad: string;
  tipo: string;
  experiencia: string;
  imagenEmpresa: string;
}

const { id } = Astro.params;

const res = await fetch(`http://localhost:8080/api/vacantes/seleccion/${id}`);
const data = await res.json();
const job = data.vacanteSeleccionada;
---

<Layout title={`${job.titulo} en ${job.nameEmpresa} | SearchJobs`}>

<Header client:load />

<div class="container">
  <div class="back-link">
    <a href="/empleos">
      <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <polyline points="15 18 9 12 15 6"></polyline>
      </svg>
      Volver a empleos
    </a>
  </div>

  <div class="job-header">
    <div class="job-header-content">
      <div class="company-logo">
        <img src={"http://localhost:8080"+job.imagenEmpresa || "/placeholder.svg"} alt={`${job.nameEmpresa} logo`} width="100" height="100" />
      </div>

      <div class="job-info">
        <h1 class="job-title">{job.titulo}</h1>
        <h2 class="company-name">{job.nameEmpresa}</h2>

        <div class="job-meta">
          <div class="job-meta-item">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="job-meta-icon">
              <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
              <circle cx="12" cy="10" r="3"></circle>
            </svg>
            <span>{job.location}</span>
          </div>
          <div class="job-meta-item">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="job-meta-icon">
              <circle cx="12" cy="12" r="10"></circle>
              <polyline points="12 6 12 12 16 14"></polyline>
            </svg>
            <span>{job.tipo}</span>
          </div>
          <div class="job-meta-item">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="job-meta-icon">
              <rect x="2" y="7" width="20" height="14" rx="2" ry="2"></rect>
              <path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"></path>
            </svg>
            <span>{job.experiencia}</span>

          </div>
          <div class="job-meta-item">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="job-meta-icon">
              <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
              <line x1="16" y1="2" x2="16" y2="6"></line>
              <line x1="8" y1="2" x2="8" y2="6"></line>
              <line x1="3" y1="10" x2="21" y2="10"></line>
            </svg>
            <span>{job.fechaPublicacion}</span>
          </div>
        </div>
      </div>

      <div class="job-actions">
        <button class="action-button" aria-label="Compartir" id="shareButton">
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="18" cy="5" r="3"></circle>
            <circle cx="6" cy="12" r="3"></circle>
            <circle cx="18" cy="19" r="3"></circle>
            <line x1="8.59" y1="13.51" x2="15.42" y2="17.49"></line>
            <line x1="15.41" y1="6.51" x2="8.59" y2="10.49"></line>
          </svg>
        </button>
        <button class="action-button" aria-label="Guardar" id="saveButton">
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M19 21l-7-5-7 5V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2z"></path>
          </svg>
        </button>
      </div>
    </div>

    <div class="apply-button-container">
      <button id="btn-Postulacion" class="btn btn-primary apply-button" data-id={id}>
        Postularme ahora
      </button>
      <a href={`/postulados/${id}`}>Ver Postulados</a>
    </div>
  </div>

  <div class="content-container">
    <div class="job-description">
      <h3 class="section-title">Descripción del empleo</h3>
      <div class="description-content" set:html={job.descripcion} />
    </div>

    <div class="sidebar">
      <div class="sidebar-card">
        <h3 class="sidebar-title">Resumen</h3>
        <div class="sidebar-content">
          <div class="sidebar-item">
            <span class="sidebar-item-label">Empresa:</span>
            <span class="sidebar-item-value">{job.nameEmpresa}</span>
          </div>
          <div class="sidebar-item">
            <span class="sidebar-item-label">Cargo:</span>
            <span class="sidebar-item-value">{job.cargo}</span>
          </div>
          <div class="sidebar-item">
            <span class="sidebar-item-label">Modalidad:</span>
            <span class="sidebar-item-value">{job.modalidad}</span>
          </div>
          <div class="sidebar-item">
            <span class="sidebar-item-label">Ubicación:</span>
            <span class="sidebar-item-value">{job.ciudad}</span>
          </div>
          <div class="sidebar-item">
            <span class="sidebar-item-label">Tipo:</span>
            <span class="sidebar-item-value">{job.tipo}</span>
          </div>
          <div class="sidebar-item">
            <span class="sidebar-item-label">Experiencia:</span>
            <span class="sidebar-item-value">{job.experiencia}</span>
          </div>
          <div class="sidebar-item">
            <span class="sidebar-item-label">Publicado:</span>
            <span class="sidebar-item-value">{job.fechaPublicacion}</span>
          </div>
        </div>
      </div>

      <div class="sidebar-card">
        <h3 class="sidebar-title">Comparte este empleo</h3>
        <div class="share-buttons">
          <button class="share-button share-facebook" id="shareFacebook">Facebook</button>
          <button class="share-button share-twitter" id="shareTwitter">Twitter</button>
          <button class="share-button share-linkedin" id="shareLinkedin">LinkedIn</button>
        </div>
      </div>
    </div>
  </div>
</div>

<Footer slot="footer" />
</Layout>

<script>
  // Script para mostrar el nombre del archivo seleccionado
  document.addEventListener('DOMContentLoaded', () => {
    // Manejo del selector de archivo
    const fileInput = document.getElementById('resume');
    const fileButton = document.getElementById('fileButton');
    const fileName = document.getElementById('fileName');
    const btnPostulacion = document.getElementById('btn-Postulacion');
    
    if (fileInput && fileButton && fileName) {
      fileButton.addEventListener('click', () => {
        fileInput.click();
      });
      
      fileInput.addEventListener('change', (e) => {
        const input = e.target as HTMLInputElement;
        if (input.files && input.files.length > 0) {
          const input = e.target as HTMLInputElement;
          if (input.files && input.files.length > 0) {
            fileName.textContent = input.files[0].name;
          }
        } else {
          fileName.textContent = 'Ningún archivo seleccionado';
        }
      });
    }

    // Manejo de botones de compartir
    const shareButtons = {
      facebook: document.getElementById('shareFacebook'),
      twitter: document.getElementById('shareTwitter'),
      linkedin: document.getElementById('shareLinkedin'),
      main: document.getElementById('shareButton')
    };

    const jobTitle = document.querySelector('.job-title')?.textContent || '';
    const jobCompany = document.querySelector('.company-name')?.textContent || '';
    const currentUrl = window.location.href;
    
    // Función para compartir en redes sociales
    const shareOnSocial = (platform: string) => {
      const text = `Oferta de trabajo: ${jobTitle} en ${jobCompany}`;
      let url = '';
      
      switch(platform) {
        case 'facebook':
          url = `https://www.facebook.com/sharer/sharer.php?u=${encodeURIComponent(currentUrl)}&quote=${encodeURIComponent(text)}`;
          break;
        case 'twitter':
          url = `https://twitter.com/intent/tweet?text=${encodeURIComponent(text)}&url=${encodeURIComponent(currentUrl)}`;
          break;
        case 'linkedin':
          url = `https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(currentUrl)}`;
          break;
      }
      
      if (url) {
        window.open(url, '_blank', 'width=600,height=400');
      }
    };
    
    // Asignar eventos a los botones de compartir
    if (shareButtons.facebook) {
      shareButtons.facebook.addEventListener('click', () => shareOnSocial('facebook'));
    }
    
    if (shareButtons.twitter) {
      shareButtons.twitter.addEventListener('click', () => shareOnSocial('twitter'));
    }
    
    if (shareButtons.linkedin) {
      shareButtons.linkedin.addEventListener('click', () => shareOnSocial('linkedin'));
    }
    
    // Botón principal de compartir
    if (shareButtons.main) {
      shareButtons.main.addEventListener('click', () => {
        // Si el navegador soporta la API de compartir nativa
        if (navigator.share) {
          navigator.share({
            title: `${jobTitle} en ${jobCompany}`,
            text: `Oferta de trabajo: ${jobTitle} en ${jobCompany}`,
            url: currentUrl
          }).catch(err => console.error('Error al compartir:', err));
        } else {
          // Mostrar opciones de compartir alternativas
          const shareCard = document.querySelector('.sidebar-card:nth-child(2)');
          if (shareCard) {
            shareCard.scrollIntoView({ behavior: 'smooth' });
          }
        }
      });
    }
    
    // Botón de guardar trabajo
    const saveButton = document.getElementById('saveButton');
    if (saveButton) {
      saveButton.addEventListener('click', function() {
        // Cambiar el visual del botón
        const isSaved = this.classList.toggle('saved');
        
        if (isSaved) {
          const svgElement = this.querySelector('svg');
          if (svgElement) {
            svgElement.setAttribute('fill', 'currentColor');
          }
          // Aquí se guarda el ID del trabajo en localStorage
          const jobId = window.location.pathname.split('/').pop();
          const savedJobs = JSON.parse(localStorage.getItem('savedJobs') || '[]');
          if (!savedJobs.includes(jobId)) {
            savedJobs.push(jobId);
            localStorage.setItem('savedJobs', JSON.stringify(savedJobs));
          }
        } else {
          const svgElement = this.querySelector('svg');
          if (svgElement) {
            svgElement.setAttribute('fill', 'none');
          }
          // Aquí se eliminar el ID del trabajo de localStorage
          const jobId = window.location.pathname.split('/').pop();
          const savedJobs = JSON.parse(localStorage.getItem('savedJobs') || '[]');
          const updatedJobs = savedJobs.filter((id: string) => id !== jobId);
          localStorage.setItem('savedJobs', JSON.stringify(updatedJobs));
        }
      });
      
      // Verificar si el trabajo ya está guardado al cargar la página
      const jobId = window.location.pathname.split('/').pop();
      const savedJobs = JSON.parse(localStorage.getItem('savedJobs') || '[]');
      if (savedJobs.includes(jobId)) {
        saveButton.classList.add('saved');
        const svgElement = saveButton.querySelector('svg');
        if (svgElement) {
          svgElement.setAttribute('fill', 'currentColor');
        }
      }
    }

    /// Peticion HTTP 

    btnPostulacion?.addEventListener("click", async () => {
      const jobId = btnPostulacion.getAttribute("data-id");

      try {
        const response = await fetch(`http://localhost:8080/api/postulados/add/${jobId}`, {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json'
          },
          credentials: 'include', // incluye cookies si usas JWT en cookies
        });

        const data = await response.json();

        if (data.status === 'success') {
          alert(data.message || "Postulación exitosa.");
        } else if (data.status === 'info') {
          alert(data.message || "Completa tu perfil para postularte.");
          window.location.href = "/perfil/candidato"; // ajusta esta ruta a la real
        } else if (data.status === 'error') {
          alert(data.message || "No se pudo realizar la postulación.");
        }

      } catch (error) {
        console.error('Error al postularse:', error);
        alert("Hubo un error al postularse.");
      }
    });

  });
</script>


