        </div>
      </article>

      <!-- Puedes añadir más vacantes aquí como en el ejemplo anterior -->
      
    </div>

    <!-- Controles de paginación -->
    <div class="pagination">
      <button id="prev" class="btn-pagina">Anterior</button>
      <span id="page-number">Página 1</span>
      <button id="next" class="btn-pagina">Siguiente</button>
    </div>
  </main>
  
  <Footer slot="footer" />
  
  <script is:inline>
    let currentPage = 1;
    const itemsPerPage = 2;
    
    document.addEventListener('DOMContentLoaded', () => {
      const vacantes = document.querySelectorAll('.vacante-card');
      const totalPages = Math.ceil(vacantes.length / itemsPerPage);
      
      const prevButton = document.getElementById('prev');
      const nextButton = document.getElementById('next');
      const pageNumber = document.getElementById('page-number');
      
      // Función para actualizar las vacantes que se muestran
      const updateVacantes = () => {
        const start = (currentPage - 1) * itemsPerPage;
        const end = start + itemsPerPage;
        
        vacantes.forEach((vacante, index) => {
          if (index >= start && index < end) {
            vacante.style.display = 'block';  // Muestra la vacante
          } else {
            vacante.style.display = 'none';  // Oculta la vacante
          }
        });
        
        pageNumber.textContent = `Página ${currentPage}`;
        prevButton.disabled = currentPage === 1;
        nextButton.disabled = currentPage === totalPages;
      };
      
      // Botón anterior
      prevButton.addEventListener('click', () => {
        if (currentPage > 1) {
          currentPage--;
          updateVacantes();
        }
      });
      
      // Botón siguiente
      nextButton.addEventListener('click', () => {
        if (currentPage < totalPages) {
          currentPage++;
          updateVacantes();
        }
      });

      // Inicializar las vacantes en la primera página
      updateVacantes();
    });
    
  </script>
  <script is:inline>
    // ... ya tienes tu script de paginación aquí
  
    // Confirmación al eliminar vacante
    function confirmarEliminacion(event) {
      const confirmar = confirm('¿Estás seguro de eliminar esta vacante?');
      if (!confirmar) {
        event.preventDefault();
        return false;
      }
      // Si quieres enviar el formulario realmente, elimina esta línea:
      event.target.submit();
      return true;
    }
  </script>
  

</Layout>
