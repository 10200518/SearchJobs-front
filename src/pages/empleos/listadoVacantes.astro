---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import '../../styles/pages/listadoVacantes.css';
// Obtener las vacantes desde la API del backend
const response = await fetch("http://localhost:8080/api/vacantes/listar", {
  method: "GET",
  credentials: "include", // si usas sesiones/cookies
  headers: {
    "Content-Type": "application/json",
  },
});

const data = await response.json();
console.log(data); // Revisa la estructura del JSON
const vacantes = data.vacantes || [];  // Accede a las vacantes dentro del mapa
---

<Layout title="Listado de Vacantes">
  <Header slot="header" />

  <main class="vacantes-container">
    <h1>Vacantes Disponibles</h1>
    <a href="Vacantes" class="btn-crear">Crear Nueva Vacante</a>

    <div class="vacantes-list">
      {vacantes.length > 0 ? (
        vacantes.map((v) => (
          <article class="vacante-card">
            <div class="vacante-info">
              <p class="titulo">TITULO: {v.titulo}</p>
              <p class="cargo">CARGO: {v.cargo}</p>
              <p class="ubicacion">ciudad: {v.ciudad}</p>
              <p class="fecha">FECHA DE PUBLICACIÓN: {v.fechaPublicacion}</p>
              <p class="departamento">DEPARTAMENTO: {v.departamento}</p>
              <p class="modalidad">MODALIDAD: {v.modalidad}</p>
              <p class="sueldo">SUELDO: ${v.sueldo}</p>
              <p class="experiencia">EXPERIENCIA: {v.experiencia}</p>
              <p class="tipo">TIPO: {v.tipo}</p>
              <p class="descripcion">{v.descripcion}</p>
              <p class="requisitos">REQUERIMINETOS: {v.requerimientos}</p>
            </div>
            <div class="vacante-actions">
              <a href={`/editar/${v.nvacantes}`} class="btn-editar">✏️ Editar</a>
              <form method="post" onsubmit="return confirmarEliminacion(event)">
                <input type="hidden" name="id" value={v.nvacantes} />
                <button type="submit" class="btn-eliminar">Eliminar</button>
              </form>
            </div>
          </article>
        ))
      ) : (
        <p>No hay vacantes disponibles</p>
      )}
    </div>

    <!-- Aquí puedes agregar paginación si la necesitas -->
     <!-- Después de tu <div class="vacantes-list"> … </div> -->
<div id="pagination-controls" class="pagination">
  <button id="prev-btn" class="btn-pagina">Anterior</button>
  <span id="page-info"></span>
  <button id="next-btn" class="btn-pagina">Siguiente</button>
</div>

<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    const vacantes = Array.from(document.querySelectorAll('.vacante-card'));
    const prevBtn = document.getElementById('prev-btn');
    const nextBtn = document.getElementById('next-btn');
    const pageInfo = document.getElementById('page-info');

    const itemsPerPage = 3;      // Cambia este valor si quieres más/menos por página
    const totalPages = Math.ceil(vacantes.length / itemsPerPage);
    let currentPage = 1;

    function renderPage(page) {
      const start = (page - 1) * itemsPerPage;
      const end = page * itemsPerPage;

      vacantes.forEach((el, idx) => {
        el.style.display = (idx >= start && idx < end) ? 'block' : 'none';
      });

      pageInfo.textContent = `Página ${page} de ${totalPages}`;
      prevBtn.disabled = page === 1;
      nextBtn.disabled = page === totalPages;
    }

    prevBtn.addEventListener('click', () => {
      if (currentPage > 1) {
        currentPage--;
        renderPage(currentPage);
      }
    });

    nextBtn.addEventListener('click', () => {
      if (currentPage < totalPages) {
        currentPage++;
        renderPage(currentPage);
      }
    });

    // Inicializa
    if (vacantes.length) {
      renderPage(currentPage);
    } else {
      pageInfo.textContent = 'No hay vacantes disponibles';
      prevBtn.style.display = nextBtn.style.display = 'none';
    }
  });
</script>

  </main>
  

  <Footer slot="footer" />
</Layout>
