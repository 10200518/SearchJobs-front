          </form>
        </div>
      </article>
      <article class="vacante-card">
        <div class="vacante-info">
          <p class="titulo">PUESTO: Desarrollador Full Stack</p>
          <p class="cargo">CARGO: Diseñador UI/UX</p>
          <p class="ubicacion">UBICACIÓN: Cali, Bolívar</p>
          <p class="fecha">FECHA DE PUBLICACIÓN: 2025-04-30</p>
